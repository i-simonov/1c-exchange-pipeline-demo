// Устанавливает следующий обработчик цепочки или возвращает ранее установленный.
//
// Параметры:
//  Обработчик - ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
//
// Возвращаемое значение:
//  ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
Функция Следующий(Обработчик = Неопределено) Экспорт

	Если Обработчик <> Неопределено Тогда
		СледующийОбработчик = Обработчик;
	КонецЕсли;

	Возврат СледующийОбработчик;

КонецФункции

// Загружает склады хранения из массива JSON и передает массив записанных ссылок дальше.
// Все склады сообщения записываются и регистрируются для отложенной записи в одной транзакции.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Вход - Произвольный - результат предыдущего обработчика.
Функция Обработать(Контекст, Вход = Неопределено) Экспорт

	// Флаг относится только к этому вызову и сбрасывается до выполнения его логики.
	ИзолированныйВызов = Контекст.Выполнение.ИзолированныйВызов;
	Контекст.Выполнение.Вставить("ИзолированныйВызов", Ложь);

	ДанныеСкладов = Вход;
	Если ДанныеСкладов = Неопределено Тогда
		ДанныеСкладов = Контекст.Вход.ДанныеСообщения;
	КонецЕсли;

	СсылкиСкладов = Новый Массив;

	НачатьТранзакцию();

	Попытка

		Для Каждого ДанныеСклада Из ДанныеСкладов Цикл

			Склад = ПолучитьСклад(ДанныеСклада["guid"]);
			Склад.ОбменДанными.Загрузка = Истина;
			Склад.ДополнительныеСвойства.Вставить("КОД_Отправитель", Контекст.Вход.УзелОтправитель);
			Склад.ДополнительныеСвойства.Вставить("КОД_ОтправлятьОбратноОтправителю", Ложь);
			ЗаполнитьСклад(Склад, ДанныеСклада);

			Склад.Записать();
			КОД_ОтложенныйПроцессинг.Зарегистрировать(Склад.Ссылка, Перечисления.КОД_ВидыОбработкиДокументов.Запись);

			СсылкиСкладов.Добавить(Склад.Ссылка);

			// Следующий элемент может иметь тот же GUID. Объектная блокировка
			// не снимается при завершении транзакции.
			Если Склад.Заблокирован() Тогда
				Склад.Разблокировать();
			КонецЕсли;

		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если НЕ ИзолированныйВызов Тогда
		ПередатьДругому(Контекст, СсылкиСкладов);
	КонецЕсли;

	Возврат СсылкиСкладов;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получает существующий склад по GUID или создает элемент с указанной ссылкой.
// Существующий элемент блокируется перед изменением, как при загрузке заказа.
Функция ПолучитьСклад(ИдентификаторСклада)

	СсылкаСклада = Справочники.Демо_КОД_СкладыХранения.ПолучитьСсылку(
		Новый УникальныйИдентификатор(ИдентификаторСклада));

	Если НЕ ЗначениеЗаполнено(СсылкаСклада) Тогда
		ВызватьИсключение "GUID склада хранения не должен быть пустым.";
	КонецЕсли;

	Склад = СсылкаСклада.ПолучитьОбъект();

	Если Склад = Неопределено Тогда
		Склад = Справочники.Демо_КОД_СкладыХранения.СоздатьЭлемент();
		Склад.УстановитьСсылкуНового(СсылкаСклада);
	Иначе
		Склад.Заблокировать();
	КонецЕсли;

	Возврат Склад;

КонецФункции

// Заполняет реквизиты склада хранения из JSON.
Процедура ЗаполнитьСклад(Склад, ДанныеСклада)

	Склад.Код = ДанныеСклада["code"];
	Склад.Наименование = ДанныеСклада["name"];

КонецПроцедуры

// Передает результат текущего обработчика следующему обработчику цепочки.
// В режиме отладки сохраняет результат в контексте без продолжения цепочки.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Выход - Произвольный - результат текущего обработчика.
Процедура ПередатьДругому(Контекст, Выход = Неопределено)

	Если Контекст.Выполнение.Режим = "Отладка" Тогда
		Контекст.Данные.ВыходыОтладки.Добавить(Выход);

		Возврат;
	КонецЕсли;

	Если СледующийОбработчик = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СледующийОбработчик.Обработать(Контекст, Выход);

КонецПроцедуры

#КонецОбласти
