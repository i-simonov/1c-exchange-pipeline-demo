#Область ПрограммныйИнтерфейс
// Возвращает декларативный реестр сценариев регистрации по объектам метаданных.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ОбъектМетаданных - объект метаданных источника регистрации.
//   * Значение - Массив - сценарии регистрации объекта.
Функция РеестрКонвейеровРегистрации() Экспорт

	РеестрСценариев = Новый Соответствие;
	СценарииТоваров = Новый Массив;
	СценарииТоваров.Добавить(СценарийРегистрацииТоваров());
	РеестрСценариев["product"] = СценарииТоваров;

	СценарииСкладов = Новый Массив;
	СценарииСкладов.Добавить(СценарийРегистрацииСкладов());
	РеестрСценариев["warehouse"] = СценарииСкладов;

	СценарииЗаказов = Новый Массив;
	СценарииЗаказов.Добавить(СценарийРегистрацииЗаказов());
	РеестрСценариев["order"] = СценарииЗаказов;

	Возврат РеестрСценариев;

КонецФункции
