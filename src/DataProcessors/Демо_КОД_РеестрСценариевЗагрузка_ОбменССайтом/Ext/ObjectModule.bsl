#Область СлужебныеПроцедурыИФункции
// Создает сценарий регистрации заказов со связанной регистрацией товаров.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - описание конвейера, обработчиков и кодов узлов.
Функция СценарийРегистрацииЗаказов()

	ОбработкиМета = Метаданные.Обработки;

	Обработчики = Новый Массив;
	//Обработчики.Добавить(ОбработкиМета.Демо_КОД_Обработчик_ВалидацияПоJSONSchema);
	// Товары загружает обработчик заказа через дочерний загрузчик в общей транзакции.
	Обработчики.Добавить(ОбработкиМета.Демо_КОД_Обработчик_JSONВЗаказ);

	ДочерниеСхемыМета = Новый Массив;
	ДочерниеСхемыМета.Добавить(ОбработкиМета.Демо_КОД_Обработчик_JSONВСкладыХранения.Макеты.СхемаВалидации);
	ДочерниеСхемыМета.Добавить(ОбработкиМета.Демо_КОД_Обработчик_JSONВТовары.Макеты.СхемаВалидации);
	ПланОбменаМета = Метаданные.ПланыОбмена.Демо_КОД_ОбменСайтом;
	КодУзла = ""; //возможно сразу жестко заложить узел при необходимости

	СтруктураСценарий = Новый Структура;
	СтруктураСценарий.Вставить("Конвейер", ОбработкиМета.КОД_КонвейерОбработчиковЗагрузкаБазовый);
	СтруктураСценарий.Вставить("Обработчики", Обработчики);
	СтруктураСценарий.Вставить("ПланОбменаМета", ПланОбменаМета);
	СтруктураСценарий.Вставить("КодУзла", КодУзла);
	СтруктураСценарий.Вставить("СхемаМета", ОбработкиМета.Демо_КОД_Обработчик_JSONВЗаказ.Макеты.СхемаВалидации);
	СтруктураСценарий.Вставить("ДочерниеСхемыМета", ДочерниеСхемыМета);

	Возврат Новый ФиксированнаяСтруктура(СтруктураСценарий);

КонецФункции
// Создает сценарий загрузки складов хранения.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - описание конвейера, обработчиков и кода узла.
Функция СценарийРегистрацииСкладов()

	ОбработкиМета = Метаданные.Обработки;

	Обработчики = Новый Массив;
	//Обработчики.Добавить(ОбработкиМета.Демо_КОД_Обработчик_ВалидацияПоJSONSchema);
	Обработчики.Добавить(ОбработкиМета.Демо_КОД_Обработчик_JSONВСкладыХранения);
	ПланОбменаМета = Метаданные.ПланыОбмена.Демо_КОД_ОбменСайтом;
	КодУзла = "";

	СтруктураСценарий = Новый Структура;
	СтруктураСценарий.Вставить("Конвейер", ОбработкиМета.КОД_КонвейерОбработчиковЗагрузкаБазовый);
	СтруктураСценарий.Вставить("Обработчики", Обработчики);
	СтруктураСценарий.Вставить("ПланОбменаМета", ПланОбменаМета);
	СтруктураСценарий.Вставить("КодУзла", КодУзла);
	СтруктураСценарий.Вставить("СхемаМета", ОбработкиМета.Демо_КОД_Обработчик_JSONВСкладыХранения.Макеты.СхемаВалидации);

	Возврат Новый ФиксированнаяСтруктура(СтруктураСценарий);

КонецФункции
