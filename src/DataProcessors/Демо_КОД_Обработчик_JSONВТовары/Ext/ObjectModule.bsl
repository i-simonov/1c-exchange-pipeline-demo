// Устанавливает следующий обработчик цепочки или возвращает ранее установленный.
//
// Параметры:
//  Обработчик - ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
//
// Возвращаемое значение:
//  ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
Функция Следующий(Обработчик = Неопределено) Экспорт

	Если Обработчик <> Неопределено Тогда
		СледующийОбработчик = Обработчик;
	КонецЕсли;

	Возврат СледующийОбработчик;

КонецФункции

// Загружает массив товаров из Вход или исходного сообщения.
// Возвращает ссылки в порядке массива, включая повторы и пустые ссылки для Null.
// Каждый объект записывается вместе со своим заданием процессинга в отдельной транзакции.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Вход - Произвольный - результат предыдущего обработчика.
Функция Обработать(Контекст, Вход = Неопределено) Экспорт

	// Флаг относится только к этому вызову и сбрасывается до выполнения его логики.
	ИзолированныйВызов = Контекст.Выполнение.ИзолированныйВызов;
	Контекст.Выполнение.Вставить("ИзолированныйВызов", Ложь);

	ДанныеТоваров = Вход;
	Если ДанныеТоваров = Неопределено Тогда
		ДанныеТоваров = Контекст.Вход.ДанныеСообщения;
	КонецЕсли;

	УзелОтправитель = Контекст.Вход.УзелОтправитель;
	СсылкиТоваров = Новый Массив;
	Для Каждого ДанныеТовара Из ДанныеТоваров Цикл

		Если ТипЗнч(ДанныеТовара) = Тип("Null") Тогда
			СсылкиТоваров.Добавить(Справочники.Демо_КОД_Товары.ПустаяСсылка());
			Продолжить;
		КонецЕсли;

		Товар = ПолучитьТовар(ДанныеТовара["guid"]);
		Товар.ОбменДанными.Загрузка = Истина;
		Товар.ДополнительныеСвойства.Вставить("КОД_Отправитель", УзелОтправитель);
		Товар.ДополнительныеСвойства.Вставить("КОД_ОтправлятьОбратноОтправителю", Ложь);
		ЗаполнитьТовар(Товар, ДанныеТовара, УзелОтправитель);

		НачатьТранзакцию();
		Попытка
			Товар.Записать();
			КОД_ОтложенныйПроцессинг.Зарегистрировать(Товар.Ссылка, Перечисления.КОД_ВидыОбработкиДокументов.Запись);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

		СсылкиТоваров.Добавить(Товар.Ссылка);

		// Следующий элемент может иметь тот же GUID. Объектная блокировка
		// не снимается при завершении транзакции.
		Если Товар.Заблокирован() Тогда
			Товар.Разблокировать();
		КонецЕсли;

	КонецЦикла;

	Если НЕ ИзолированныйВызов Тогда
		ПередатьДругому(Контекст, СсылкиТоваров);
	КонецЕсли;

	Возврат СсылкиТоваров;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получает существующий товар по GUID или создает элемент с указанной ссылкой.
Функция ПолучитьТовар(ИдентификаторТовара)

	СсылкаТовара = Справочники.Демо_КОД_Товары.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторТовара));

	Если НЕ ЗначениеЗаполнено(СсылкаТовара) Тогда
		ВызватьИсключение "GUID товара не должен быть пустым.";
	КонецЕсли;

	Товар = СсылкаТовара.ПолучитьОбъект();

	Если Товар = Неопределено Тогда
		Товар = Справочники.Демо_КОД_Товары.СоздатьЭлемент();
		Товар.УстановитьСсылкуНового(СсылкаТовара);
	Иначе
		Товар.Заблокировать();
	КонецЕсли;

	Возврат Товар;

КонецФункции

// Отсутствующее поле category сохраняет категорию, явный null очищает ее.
Процедура ЗаполнитьТовар(Товар, ДанныеТовара, УзелОтправитель)

	Товар.Код = ДанныеТовара["code"];
	Товар.Наименование = ДанныеТовара["name"];

	ДанныеКатегории = ДанныеТовара["category"];

	Если ДанныеКатегории = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ДанныеКатегории) = Тип("Null") Тогда
		Товар.Категория = Справочники.Демо_КОД_КатегорииТоваров.ПустаяСсылка();
	Иначе
		Товар.Категория = ЗагрузитьКатегорию(ДанныеКатегории, УзелОтправитель);
	КонецЕсли;

КонецПроцедуры

// Записывает категорию и ее задание процессинга в одной транзакции.
Функция ЗагрузитьКатегорию(ДанныеКатегории, УзелОтправитель)

	СсылкаКатегории = Справочники.Демо_КОД_КатегорииТоваров.ПолучитьСсылку(
		Новый УникальныйИдентификатор(ДанныеКатегории["guid"]));

	Если НЕ ЗначениеЗаполнено(СсылкаКатегории) Тогда
		ВызватьИсключение "GUID категории товара не должен быть пустым.";
	КонецЕсли;

	Категория = СсылкаКатегории.ПолучитьОбъект();

	Если Категория = Неопределено Тогда
		Категория = Справочники.Демо_КОД_КатегорииТоваров.СоздатьЭлемент();
		Категория.УстановитьСсылкуНового(СсылкаКатегории);
	Иначе
		Категория.Заблокировать();
	КонецЕсли;

	Категория.ОбменДанными.Загрузка = Истина;
	Категория.ДополнительныеСвойства.Вставить("КОД_Отправитель", УзелОтправитель);
	Категория.ДополнительныеСвойства.Вставить("КОД_ОтправлятьОбратноОтправителю", Ложь);
	Категория.Код = ДанныеКатегории["code"];
	Категория.Наименование = ДанныеКатегории["name"];

	НачатьТранзакцию();
	Попытка
		Категория.Записать();
		КОД_ОтложенныйПроцессинг.Зарегистрировать(Категория.Ссылка, Перечисления.КОД_ВидыОбработкиДокументов.Запись);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Категория.Ссылка;

КонецФункции

// Передает результат текущего обработчика следующему обработчику цепочки.
// В режиме отладки сохраняет результат в контексте без продолжения цепочки.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Выход - Произвольный - результат текущего обработчика.
Процедура ПередатьДругому(Контекст, Выход = Неопределено)

	Если Контекст.Выполнение.Режим = "Отладка" Тогда
		Контекст.Данные.ВыходыОтладки.Добавить(Выход);

		Возврат;
	КонецЕсли;

	Если СледующийОбработчик = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СледующийОбработчик.Обработать(Контекст, Выход);

КонецПроцедуры

#КонецОбласти
