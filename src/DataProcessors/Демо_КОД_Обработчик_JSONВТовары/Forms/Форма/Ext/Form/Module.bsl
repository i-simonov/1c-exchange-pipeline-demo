&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(ПланОбмена) Тогда
		ПланОбмена = ПланыОбмена.Демо_КОД_ОбменСайтом.НайтиПоКоду("WEB");
	КонецЕсли;
	ОбновитьСценарииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Обновляем список после восстановления сохраненных настроек формы.
	ОбновитьСценарииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПланОбменаПриИзменении(Элемент)

	ТаблицаСообщениеОбъект.Очистить();
	ОбновитьСценарииНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСценарииНаСервере()

	Элементы.Сценарий.РежимВыбораИзСписка = Истина;
	СписокСценариев = Элементы.Сценарий.СписокВыбора;
	СписокСценариев.Очистить();
	Обработчик = РеквизитФормыВЗначение("Объект");
	Для Каждого Описание Из СценарииЗагрузки(Обработчик.Метаданные(), ПланОбмена) Цикл
		СписокСценариев.Добавить(Описание.Ключ, Описание.Представление);
	КонецЦикла;

	Если СписокСценариев.НайтиПоЗначению(Сценарий) = Неопределено Тогда
		Сценарий = "";
		Если СписокСценариев.Количество() > 0 Тогда
			Сценарий = СписокСценариев[0].Значение;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()

	ТаблицаСообщениеОбъект.Очистить();
	Обработчик = РеквизитФормыВЗначение("Объект");
	Результат = ЗагрузитьСообщение(Обработчик, ПланОбмена, Сценарий, ПолеДжсон);
	ЗначениеВРеквизитФормы(Результат, "ТаблицаСообщениеОбъект");

КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)

	ЗагрузитьНаСервере();
	Элементы.Страницы.ТекущаяСтраница = Элементы.РезультатыЗагрузки;
	Если ТаблицаСообщениеОбъект.Количество() = 0 Тогда
		Сообщить("Сообщение обработано. Нет объектов для загрузки.");
	КонецЕсли;

КонецПроцедуры

#Область ЗагрузкаСообщения

// Возвращает только сценарии загрузки выбранного плана, содержащие обработчик.
// Метаданные остаются на сервере; в список выбора формы передаются ключ и представление.
&НаСервереБезКонтекста
Функция СценарииЗагрузки(ОбработчикМета, ПланОбмена)

	Результат = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ПланОбмена) Тогда
		Возврат Результат;
	КонецЕсли;

	Реестры = КОД_ДиспетчерЗагрузкиСообщений.РеестрыСценариевПоОтправителям();
	Для Каждого РеестрПоОтправителю Из Реестры Цикл
		Реестр = КОД_ДиспетчерЗагрузкиСообщений.ПолучитьОбъектОбработки(РеестрПоОтправителю.Значение);
		Для Каждого СценарииПоТипу Из Реестр.РеестрКонвейеровРегистрации() Цикл
			НомерСценария = 0;
			Для Каждого Сценарий Из СценарииПоТипу.Значение Цикл
				НомерСценария = НомерСценария + 1;
				Если Сценарий.ПланОбменаМета <> ПланОбмена.Метаданные()
					ИЛИ Сценарий.Обработчики.Найти(ОбработчикМета) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(Сценарий.КодУзла)
					И Сценарий.КодУзла <> ПланОбмена.Код Тогда
					Продолжить;
				КонецЕсли;

				Описание = Новый Структура;
				Описание.Вставить("Ключ", СтрШаблон("%1 / %2 / %3",
					РеестрПоОтправителю.Ключ, СценарииПоТипу.Ключ, НомерСценария));
				Описание.Вставить("Представление", СтрШаблон("%1 — %2",
					Описание.Ключ, Сценарий.Конвейер.Синоним));
				Описание.Вставить("Сценарий", Сценарий);
				Описание.Вставить("Отправитель", РеестрПоОтправителю.Ключ);
				Описание.Вставить("ТипСообщения", СценарииПоТипу.Ключ);
				Результат.Добавить(Описание);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Запускает сам обработчик в контексте загрузки. Режим отладки останавливает
// продолжение цепочки, но записи объектов и задания отложенного процессинга сохраняются.
// Весь ручной запуск атомарен, включая дочерние загрузчики и подготовку результата.
&НаСервереБезКонтекста
Функция ЗагрузитьСообщение(Обработчик, ПланОбмена, КлючСценария, ТелоСообщения)

	Результат = НоваяТаблицаРезультата();
	Попытка
		Если НЕ ЗначениеЗаполнено(ПланОбмена) Тогда
			ВызватьИсключение "Выберите узел плана обмена.";
		КонецЕсли;
		Если ПустаяСтрока(ТелоСообщения) Тогда
			ВызватьИсключение "Введите JSON сообщения.";
		КонецЕсли;

		ОписаниеСценария = Неопределено;
		Для Каждого Описание Из СценарииЗагрузки(Обработчик.Метаданные(), ПланОбмена) Цикл
			Если Описание.Ключ = КлючСценария Тогда
				ОписаниеСценария = Описание;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ОписаниеСценария = Неопределено Тогда
			ВызватьИсключение "Выберите доступный сценарий загрузки для этого обработчика и плана обмена.";
		КонецЕсли;

		Сообщение = Новый Структура;
		Сообщение.Вставить("ТелоСообщения", ТелоСообщения);
		Сообщение.Вставить("Отправитель", ОписаниеСценария.Отправитель);
		Сообщение.Вставить("УзелОбмена", ПланОбмена);
		Сообщение.Вставить("ТипСообщения", ОписаниеСценария.ТипСообщения);
		Сообщение.Вставить("Идентификатор", Новый УникальныйИдентификатор);
		Сообщение.Вставить("НомерСообщения", 0);
		Сообщение.Вставить("ДатаВремя", ТекущаяДата());
		Заголовки = Новый Структура("content_type", ОписаниеСценария.ТипСообщения);
		Сообщение.Вставить("Заголовки", ЗначениеВJSON(Заголовки));
		Конвейер = КОД_ДиспетчерЗагрузкиСообщений.ПолучитьОбъектОбработки(ОписаниеСценария.Сценарий.Конвейер);
		Контекст = Конвейер.НовыйКонтекстВыполнения(ОписаниеСценария.Сценарий, Сообщение, "Отладка");

		НачатьТранзакцию();
		Попытка
			Выход = Обработчик.Обработать(Контекст);
			ЗаполнитьРезультат(Результат, Контекст.Вход.ДанныеСообщения, Выход);
			ЗафиксироватьТранзакцию();
		Исключение
			// Дочерний загрузчик может уже отменить транзакцию своим обработчиком исключения.
			// BSLLS:WrongUseOfRollbackTransactionMethod-off
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			// BSLLS:WrongUseOfRollbackTransactionMethod-on
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		// После отката нельзя показывать ссылки на несохраненные объекты.
		Результат.Очистить();
		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.Сообщение = ТелоСообщения;
		СтрокаРезультата.Ошибка = Истина;
		СтрокаРезультата.ОписаниеОшибки = ТекстОшибки;
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция НоваяТаблицаРезультата()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Сообщение", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Объект", Новый ОписаниеТипов(
		"ДокументСсылка.Демо_Заказ, СправочникСсылка.Демо_КОД_Товары, СправочникСсылка.Демо_КОД_СкладыХранения"));
	Результат.Колонки.Добавить("Ошибка", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ОписаниеОшибки", Новый ОписаниеТипов("Строка"));

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьРезультат(Результат, ДанныеСообщения, Выход)

	Если ТипЗнч(ДанныеСообщения) = Тип("Массив") Тогда
		Если ТипЗнч(Выход) <> Тип("Массив") Тогда
			ВызватьИсключение "Загрузчик массива должен вернуть массив ссылок.";
		КонецЕсли;
		Если ДанныеСообщения.Количество() <> Выход.Количество() Тогда
			ВызватьИсключение "Количество ссылок не совпадает с количеством элементов сообщения.";
		КонецЕсли;
		Для Индекс = 0 По Выход.Количество() - 1 Цикл
			ДобавитьСтрокуРезультата(Результат, ДанныеСообщения[Индекс], Выход[Индекс]);
		КонецЦикла;
	Иначе
		ДобавитьСтрокуРезультата(Результат, ДанныеСообщения, Выход);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСтрокуРезультата(Результат, ДанныеСообщения, Ссылка)

	Если НЕ Результат.Колонки.Объект.ТипЗначения.СодержитТип(ТипЗнч(Ссылка)) Тогда
		ВызватьИсключение "Загрузчик должен вернуть ссылку на загруженный объект.";
	КонецЕсли;
	СтрокаРезультата = Результат.Добавить();
	СтрокаРезультата.Сообщение = ЗначениеВJSON(ДанныеСообщения);
	СтрокаРезультата.Объект = Ссылка;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеВJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);

	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
