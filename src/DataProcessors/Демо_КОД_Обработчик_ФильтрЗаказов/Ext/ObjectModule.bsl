Функция Следующий(Обработчик = Неопределено) Экспорт
	
	Если Обработчик <> Неопределено Тогда
		СледующийОбработчик = Обработчик;
	КонецЕсли;
	
	Возврат СледующийОбработчик;
	
КонецФункции

Процедура Обработать(Контекст, Вход = Неопределено) Экспорт
	
	ОбеспечитьПредыдущуюВерсию(Контекст);
	
	Фильтрация(Контекст);
	
	ПередатьДругому(Контекст, Вход);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Фильтрация(Контекст)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Контекст.Выполнение.МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивСсылок", Контекст.Вход.МассивСсылок);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Версии.Ссылка КАК Ссылка,
		|	Версии.Склад КАК Склад //для целей маршрутизации
		|ПОМЕСТИТЬ ВТ_СсылкиПослеФильтра
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТекущаяВерсия.Ссылка КАК Ссылка,
		|		ТекущаяВерсия.ПометкаУдаления КАК ПометкаУдаления,
		|		ТекущаяВерсия.Проведен КАК Проведен,
		|		ТекущаяВерсия.Склад КАК Склад
		|	ИЗ
		|		Документ.Демо_Заказ КАК ТекущаяВерсия
		|	ГДЕ
		|		ТекущаяВерсия.Ссылка В (&МассивСсылок)
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		ПредыдущаяВерсия.Ссылка,
		|		ПредыдущаяВерсия.ПометкаУдаления,
		|		ПредыдущаяВерсия.Проведен,
		|		ПредыдущаяВерсия.Склад
		|	ИЗ
		|		ВТ_ПредыдущаяВерсия КАК ПредыдущаяВерсия) КАК Версии
		|ГДЕ
		|	НЕ Версии.ПометкаУдаления И Версии.Проведен";
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ОбеспечитьПредыдущуюВерсию(Контекст)
	
	МенеджерВременныхТаблиц = Контекст.Выполнение.МенеджерВременныхТаблиц;
	
	Если КОД_ДиспетчерРегистрацииКОбмену.ВременнаяТаблицаСуществует(
		МенеджерВременныхТаблиц,
		"ВТ_ПредыдущаяВерсия") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ОбъектМетаданных = Метаданные.Документы.Демо_Заказ;
	ПоляОбъекта = КОД_ДиспетчерРегистрацииКОбмену.ПоляОбъектаДляЗапроса(ОбъектМетаданных, "Источник");
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	&ПоляОбъекта
		|ПОМЕСТИТЬ ВТ_ПредыдущаяВерсия
		|ИЗ
		|	&Источник КАК Источник
		|ГДЕ
		|	ЛОЖЬ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Источник", ОбъектМетаданных.ПолноеИмя());
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляОбъекта", ПоляОбъекта);
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПередатьДругому(Контекст, Выход = Неопределено)
	
	Если СледующийОбработчик = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СледующийОбработчик.Обработать(Контекст, Выход);
	
КонецПроцедуры

#КонецОбласти
