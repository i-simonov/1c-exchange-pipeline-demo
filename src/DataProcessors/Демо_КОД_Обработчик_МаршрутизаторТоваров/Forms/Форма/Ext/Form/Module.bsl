&НаСервере
Процедура ВыполнитьМаршрутизациюНаСервере()
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Не выбрана ссылка.";
	КонецЕсли;
	ПланОбменаМета = Метаданные.НайтиПоПолномуИмени(ПланОбменаПолноеИмя);
	КонвейерМета = Метаданные.НайтиПоПолномуИмени(КонвейерПолноеИмя);
	ОбъектМетаданных = Метаданные.Справочники.Демо_КОД_Товары;
	Сценарий = НайтиСценарий(ПланОбменаМета, ОбъектМетаданных, КонвейерМета);
	Если Сценарий = Неопределено Тогда
		ВызватьИсключение "Сценарий выполнения не найден.";
	КонецЕсли;
	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(Ссылка);
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Конвейер = КОД_ДиспетчерРегистрацииКОбмену.ПолучитьОбъектОбработки(КонвейерМета);
	Контекст = Конвейер.НовыйКонтекстВыполнения(Сценарий, МассивСсылок, ОбъектМетаданных, ПланОбменаМета, МенеджерВременныхТаблиц, "Отладка");

	ТаблицаСсылок = Новый ТаблицаЗначений;
	ТаблицаСсылок.Колонки.Добавить("Ссылка", Новый ОписаниеТипов(ТипЗнч(Ссылка)));
	СтрокаСсылки = ТаблицаСсылок.Добавить();
	СтрокаСсылки.Ссылка = Ссылка;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТаблицаСсылок", ТаблицаСсылок);
	Запрос.Текст = "ВЫБРАТЬ Ссылки.Ссылка КАК Ссылка ПОМЕСТИТЬ ВТ_СсылкиПослеФильтра ИЗ &ТаблицаСсылок КАК Ссылки";
	Запрос.Выполнить();
	Обработчик = РеквизитФормыВЗначение("Объект");
	Обработчик.Обработать(Контекст);
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ * ИЗ ВТ_СсылкиПоУзлам";
	Результат = Запрос.Выполнить().Выгрузить();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьМаршрутизацию(Команда)
	ВыполнитьМаршрутизациюНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСпискиВыбора(Метаданные.Справочники.Демо_КОД_Товары);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланОбменаПолноеИмяПриИзменении(Элемент)
	
	ЗаполнитьСписокКонвейеровНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокКонвейеровНаСервере()
	
	ЗаполнитьСписокКонвейеров(Метаданные.Справочники.Демо_КОД_Товары);
	
КонецПроцедуры

// Заполняет списки выбора планов обмена и конвейеров по реестрам сценариев.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект, для которого отбираются сценарии.
//
&НаСервере
Процедура ЗаполнитьСпискиВыбора(ОбъектМетаданных)
	
	СписокВыбораПланов = Элементы.ПланОбменаПолноеИмя.СписокВыбора;
	СписокВыбораПланов.Очистить();
	
	СоответствиеРеестров =
		КОД_ДиспетчерРегистрацииКОбмену.РеестрыСценариевПоПланамОбмена();
	
	Для Каждого ПланОбменаРеестр Из СоответствиеРеестров Цикл
		
		Реестр =
			КОД_ДиспетчерРегистрацииКОбмену.ПолучитьОбъектОбработки(
				ПланОбменаРеестр.Значение).РеестрКонвейеровРегистрации();
		
		МассивСценариев = Реестр[ОбъектМетаданных];
		Если МассивСценариев = Неопределено Или МассивСценариев.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПланОбменаМета = ПланОбменаРеестр.Ключ;
		ПредставлениеПлана = ?(ПустаяСтрока(ПланОбменаМета.Синоним), ПланОбменаМета.Имя, ПланОбменаМета.Синоним);
		СписокВыбораПланов.Добавить(ПланОбменаМета.ПолноеИмя(), ПредставлениеПлана);
		
	КонецЦикла;
	
	Если СписокВыбораПланов.Количество() = 0 Тогда
		ПланОбменаПолноеИмя = "";
		КонвейерПолноеИмя = "";
		Элементы.КонвейерПолноеИмя.СписокВыбора.Очистить();
		Возврат;
	КонецЕсли;
	
	Если СписокВыбораПланов.НайтиПоЗначению(ПланОбменаПолноеИмя) = Неопределено Тогда
		ПланОбменаПолноеИмя = СписокВыбораПланов.Получить(0).Значение;
	КонецЕсли;
	
	ЗаполнитьСписокКонвейеров(ОбъектМетаданных);
	
КонецПроцедуры

// Заполняет список выбора конвейеров для выбранного плана обмена.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект, для которого отбираются сценарии.
//
&НаСервере
Процедура ЗаполнитьСписокКонвейеров(ОбъектМетаданных)
	
	СписокВыбораКонвейеров = Элементы.КонвейерПолноеИмя.СписокВыбора;
	СписокВыбораКонвейеров.Очистить();
	
	ПланОбменаМета = Метаданные.НайтиПоПолномуИмени(ПланОбменаПолноеИмя);
	МассивСценариев = ПолучитьСценарииРегистрации(ПланОбменаМета, ОбъектМетаданных);
	
	Если МассивСценариев <> Неопределено Тогда
		Для Каждого Сценарий Из МассивСценариев Цикл
			ПолноеИмяКонвейера = Сценарий.Конвейер.ПолноеИмя();
			Если СписокВыбораКонвейеров.НайтиПоЗначению(ПолноеИмяКонвейера) = Неопределено Тогда
				ПредставлениеКонвейера = ?(ПустаяСтрока(Сценарий.Конвейер.Синоним), Сценарий.Конвейер.Имя, Сценарий.Конвейер.Синоним);
				СписокВыбораКонвейеров.Добавить(ПолноеИмяКонвейера, ПредставлениеКонвейера);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СписокВыбораКонвейеров.Количество() = 0 Тогда
		КонвейерПолноеИмя = "";
	ИначеЕсли СписокВыбораКонвейеров.НайтиПоЗначению(КонвейерПолноеИмя) = Неопределено Тогда
		КонвейерПолноеИмя = СписокВыбораКонвейеров.Получить(0).Значение;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает сценарии регистрации объекта для плана обмена.
//
// Параметры:
//  ПланОбменаМета - ОбъектМетаданныхПланОбмена, Неопределено - план обмена.
//  ОбъектМетаданных - ОбъектМетаданных - регистрируемый объект.
//
// Возвращаемое значение:
//  Массив, Неопределено - сценарии регистрации объекта.
//
&НаСервере
Функция ПолучитьСценарииРегистрации(ПланОбменаМета, ОбъектМетаданных)
	
	Если ПланОбменаМета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СоответствиеРеестров =
		КОД_ДиспетчерРегистрацииКОбмену.РеестрыСценариевПоПланамОбмена();
	
	ОбработкаРеестрМета = СоответствиеРеестров[ПланОбменаМета];
	Если ОбработкаРеестрМета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Реестр =
		КОД_ДиспетчерРегистрацииКОбмену.ПолучитьОбъектОбработки(
			ОбработкаРеестрМета).РеестрКонвейеровРегистрации();
	
	Возврат Реестр[ОбъектМетаданных];
	
КонецФункции

&НаСервере
Функция НайтиСценарий(ПланОбменаМета, ОбъектМетаданных, КонвейерМета)
	
	МассивСценариев = ПолучитьСценарииРегистрации(ПланОбменаМета, ОбъектМетаданных);
	Если МассивСценариев = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого Сценарий Из МассивСценариев Цикл
		Если Сценарий.Конвейер = КонвейерМета Тогда
			Возврат Сценарий;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции
