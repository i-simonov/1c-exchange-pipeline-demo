КонецФункции
// Устанавливает следующий обработчик цепочки или возвращает ранее установленный.
//
// Параметры:
//  Обработчик - ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
//
// Возвращаемое значение:
//  ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
Функция Следующий(Обработчик = Неопределено) Экспорт

	Если Обработчик <> Неопределено Тогда
		СледующийОбработчик = Обработчик;
	КонецЕсли;

	Возврат СледующийОбработчик;

КонецФункции
// Загружает шапку, склад и товары заказа из JSON. Запись заказа и его задания
// процессинга выполняется в одной транзакции после загрузки склада и товаров.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Вход - Произвольный - результат предыдущего обработчика.
Функция Обработать(Контекст, Вход = Неопределено) Экспорт

	// Флаг относится только к этому вызову и сбрасывается до выполнения его логики.
	ИзолированныйВызов = Контекст.Выполнение.ИзолированныйВызов;
	Контекст.Выполнение.Вставить("ИзолированныйВызов", Ложь);

	ДанныеЗаказа = Вход;
	Если ДанныеЗаказа = Неопределено Тогда
		ДанныеЗаказа = Контекст.Вход.ДанныеСообщения;
	КонецЕсли;
	НомерЗаказа = ДанныеЗаказа["number"];
	ДатаЗаказа = ДатаИзJSON(ДанныеЗаказа["date"]);
	СтрокиЗаказа = ДанныеЗаказа["items"];
	ДанныеТоваров = Новый Массив;

	Для Каждого СтрокаЗаказа Из СтрокиЗаказа Цикл
		ДанныеТоваров.Добавить(СтрокаЗаказа["product"]);
	КонецЦикла;

	ОбработчикТоваров = ПолучитьОбработчикТоваров();
	СсылкаЗаказа = НайтиЗаказ(НомерЗаказа, ДатаЗаказа);

	Если ЗначениеЗаполнено(СсылкаЗаказа) Тогда
		Заказ = СсылкаЗаказа.ПолучитьОбъект();
		Заказ.Заблокировать();
	Иначе
		Заказ = Документы.Демо_Заказ.СоздатьДокумент();
	КонецЕсли;

	Заказ.ОбменДанными.Загрузка = Истина;
	Заказ.ДополнительныеСвойства.Вставить("КОД_Отправитель", Контекст.Вход.УзелОтправитель);
	Заказ.ДополнительныеСвойства.Вставить("КОД_ОтправлятьОбратноОтправителю", Ложь);
	ЗаполнитьШапку(Заказ, ДанныеЗаказа, ДатаЗаказа);
	Заказ.Склад = ЗагрузитьСклад(Контекст, ДанныеЗаказа["warehouse"]);

	Контекст.Выполнение.Вставить("ИзолированныйВызов", Истина);
	СсылкиТоваров = ОбработчикТоваров.Обработать(Контекст, ДанныеТоваров);
	ЗаполнитьТовары(Заказ, СтрокиЗаказа, СсылкиТоваров);

	НачатьТранзакцию();
	Попытка
		Заказ.Записать();
		КОД_ОтложенныйПроцессинг.Зарегистрировать(Заказ.Ссылка, Перечисления.КОД_ВидыОбработкиДокументов.Проведение);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если НЕ ИзолированныйВызов Тогда
		ПередатьДругому(Контекст, Заказ.Ссылка);
	КонецЕсли;

	Возврат Заказ.Ссылка;

КонецФункции
#КонецОбласти
#Область СлужебныеПроцедурыИФункции
// Ищет заказ по точному совпадению номера и даты.
Функция НайтиЗаказ(НомерЗаказа, ДатаЗаказа)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номер", НомерЗаказа);
	Запрос.УстановитьПараметр("Дата", ДатаЗаказа);

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Заказы.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Демо_Заказ КАК Заказы
		|ГДЕ
		|	Заказы.Номер = &Номер
		|	И Заказы.Дата = &Дата";
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Документы.Демо_Заказ.ПустаяСсылка();

КонецФункции
// Заполняет реквизиты шапки заказа.
Процедура ЗаполнитьШапку(Заказ, ДанныеЗаказа, ДатаЗаказа)

	Заказ.Номер = ДанныеЗаказа["number"];
	Заказ.Дата = ДатаЗаказа;

КонецПроцедуры
// Преобразует дату JSON формата YYYY-MM-DDTHH:MM:SS в дату 1С.
Функция ДатаИзJSON(ДатаJSON)

	Попытка
		Возврат Дата(Число(Лев(ДатаJSON, 4)), Число(Сред(ДатаJSON, 6, 2)), Число(Сред(ДатаJSON, 9, 2)),
			Число(Сред(ДатаJSON, 12, 2)), Число(Сред(ДатаJSON, 15, 2)), Число(Сред(ДатаJSON, 18, 2)));
	Исключение
		ВызватьИсключение СтрШаблон("Неверный формат даты заказа: %1.", ДатаJSON);
	КонецПопытки;

КонецФункции
// Фабрика позволяет заменить встроенный загрузчик внешней обработкой.
// Экземпляр сохраняется на время жизни обработчика заказа.
Функция ПолучитьОбработчикТоваров()

	Если КэшОбработчикаТоваров = Неопределено Тогда
		КэшОбработчикаТоваров = КОД_ДиспетчерЗагрузкиСообщений.ПолучитьОбъектОбработки(
			Метаданные.Обработки.Демо_КОД_Обработчик_JSONВТовары);
	КонецЕсли;

	Возврат КэшОбработчикаТоваров;

КонецФункции
// Фабрика позволяет заменить встроенный загрузчик складов внешней обработкой.
// Экземпляр сохраняется на время жизни обработчика заказа.
Функция ПолучитьОбработчикСкладов()

	Если КэшОбработчикаСкладов = Неопределено Тогда
		КэшОбработчикаСкладов = КОД_ДиспетчерЗагрузкиСообщений.ПолучитьОбъектОбработки(
			Метаданные.Обработки.Демо_КОД_Обработчик_JSONВСкладыХранения);
	КонецЕсли;

	Возврат КэшОбработчикаСкладов;

КонецФункции
// Загружает склад отдельным дочерним вызовом; явный null очищает склад заказа.
Функция ЗагрузитьСклад(Контекст, ДанныеСклада)

	Если ТипЗнч(ДанныеСклада) = Тип("Null") Тогда
		Возврат Справочники.Демо_КОД_СкладыХранения.ПустаяСсылка();
	КонецЕсли;

	ДанныеСкладов = Новый Массив;
	ДанныеСкладов.Добавить(ДанныеСклада);
	ОбработчикСкладов = ПолучитьОбработчикСкладов();
	Контекст.Выполнение.Вставить("ИзолированныйВызов", Истина);
	СсылкиСкладов = ОбработчикСкладов.Обработать(Контекст, ДанныеСкладов);

	Если ТипЗнч(СсылкиСкладов) <> Тип("Массив") Тогда
		ВызватьИсключение "Загрузчик складов должен вернуть массив ссылок.";
	КонецЕсли;

	Если СсылкиСкладов.Количество() <> 1 Тогда
		ВызватьИсключение "Загрузчик складов должен вернуть одну ссылку для склада заказа.";
	КонецЕсли;

	Если ТипЗнч(СсылкиСкладов[0]) <> Тип("СправочникСсылка.Демо_КОД_СкладыХранения") Тогда
		ВызватьИсключение "Загрузчик складов должен вернуть ссылку на склад хранения.";
	КонецЕсли;

	Возврат СсылкиСкладов[0];

КонецФункции
// Полностью заменяет состав заказа в порядке items, включая повторы и пустые ссылки.
Процедура ЗаполнитьТовары(Заказ, СтрокиЗаказа, СсылкиТоваров)

	Если ТипЗнч(СсылкиТоваров) <> Тип("Массив") Тогда
		ВызватьИсключение "Загрузчик товаров должен вернуть массив ссылок.";
	КонецЕсли;

	Если СсылкиТоваров.Количество() <> СтрокиЗаказа.Количество() Тогда
		ВызватьИсключение "Количество ссылок загрузчика товаров не совпадает с количеством строк заказа.";
	КонецЕсли;

	Заказ.Товары.Очистить();
	ИндексСтроки = 0;

	Для Каждого ДанныеСтроки Из СтрокиЗаказа Цикл
		СтрокаТоваров = Заказ.Товары.Добавить();
		СтрокаТоваров.Товар = СсылкиТоваров[ИндексСтроки];
		СтрокаТоваров.Количество = ДанныеСтроки["quantity"];
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;

КонецПроцедуры
// Передает сформированный выход следующему обработчику цепочки.
// В режиме отладки сохраняет выход в контексте без продолжения цепочки.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Выход - Произвольный - результат текущего обработчика.
Процедура ПередатьДругому(Контекст, Выход = Неопределено)

	Если Контекст.Выполнение.Режим = "Отладка" Тогда
		Контекст.Данные.ВыходыОтладки.Добавить(Выход);

		Возврат;
	КонецЕсли;

	Если СледующийОбработчик = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СледующийОбработчик.Обработать(Контекст, Выход);

КонецПроцедуры
#КонецОбласти
