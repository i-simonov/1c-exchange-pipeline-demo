// Устанавливает следующий обработчик цепочки или возвращает ранее установленный.
//
// Параметры:
//  Обработчик - ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
//
// Возвращаемое значение:
//  ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
Функция Следующий(Обработчик = Неопределено) Экспорт

	Если Обработчик <> Неопределено Тогда
		СледующийОбработчик = Обработчик;
	КонецЕсли;

	Возврат СледующийОбработчик;

КонецФункции

// Получает товары из заказов, прошедших маршрутизацию, и добавляет их
// в общую очередь связанной регистрации отдельными заданиями по узлам.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Вход - Произвольный - результат предыдущего обработчика.
Функция Обработать(Контекст, Вход = Неопределено) Экспорт

	// Флаг относится только к этому вызову и сбрасывается до выполнения его логики.
	ИзолированныйВызов = Контекст.Выполнение.ИзолированныйВызов;
	Контекст.Выполнение.Вставить("ИзолированныйВызов", Ложь);

	СвязанныеСсылкиПоУзлам = ПолучитьСвязанныеСсылкиПоУзлам(Контекст);

	Для Каждого СсылкиУзла Из СвязанныеСсылкиПоУзлам Цикл

		КодыУзлов = Новый Массив;
		КодыУзлов.Добавить(СсылкиУзла.Ключ);

		КОД_ДиспетчерРегистрацииКОбмену.ДобавитьЗаданиеРегистрации(
			Контекст.Данные.КонтекстРегистрации,
			Метаданные.Справочники.Демо_КОД_Товары,
			СсылкиУзла.Значение,
			КодыУзлов);

	КонецЦикла;

	Если НЕ ИзолированныйВызов Тогда
		ПередатьДругому(Контекст, Вход);
	КонецЕсли;

	Возврат Вход;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает связанные товары отдельно для каждого узла исходных заказов.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//
// Возвращаемое значение:
//  Соответствие - код узла -> массив уникальных ссылок товаров.
Функция ПолучитьСвязанныеСсылкиПоУзлам(Контекст)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Контекст.Выполнение.МенеджерВременныхТаблиц;

	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Маршруты.Узел.Код КАК КодУзла,
		|	Товары.Товар КАК Ссылка
		|ИЗ
		|	ВТ_СсылкиПоУзлам КАК Маршруты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Демо_Заказ.Товары КАК Товары
		|		ПО Маршруты.Ссылка = Товары.Ссылка";

	СсылкиПоУзлам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		СсылкиУзла = СсылкиПоУзлам.Получить(Выборка.КодУзла);
		Если СсылкиУзла = Неопределено Тогда
			СсылкиУзла = Новый Массив;
			СсылкиПоУзлам.Вставить(Выборка.КодУзла, СсылкиУзла);
		КонецЕсли;

		СсылкиУзла.Добавить(Выборка.Ссылка);

	КонецЦикла;

	Возврат СсылкиПоУзлам;

КонецФункции

// Передает управление следующему обработчику цепочки.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Выход - Произвольный - результат текущего обработчика.
Процедура ПередатьДругому(Контекст, Выход = Неопределено)

	Если СледующийОбработчик = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СледующийОбработчик.Обработать(Контекст, Выход);

КонецПроцедуры

#КонецОбласти
