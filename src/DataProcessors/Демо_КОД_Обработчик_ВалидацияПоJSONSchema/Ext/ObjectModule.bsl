// Устанавливает следующий обработчик цепочки или возвращает ранее установленный.
//
// Параметры:
//  Обработчик - ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
//
// Возвращаемое значение:
//  ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
Функция Следующий(Обработчик = Неопределено) Экспорт

	Если Обработчик <> Неопределено Тогда
		СледующийОбработчик = Обработчик;
	КонецЕсли;

	Возврат СледующийОбработчик;

КонецФункции
// Проверяет исходное тело входящего сообщения по JSON Schema и передает вход дальше.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Вход - Произвольный - результат предыдущего обработчика.
Функция Обработать(Контекст, Вход = Неопределено) Экспорт

	// Флаг относится только к этому вызову и сбрасывается до выполнения его логики.
	ИзолированныйВызов = Контекст.Выполнение.ИзолированныйВызов;
	Контекст.Выполнение.Вставить("ИзолированныйВызов", Ложь);

	Если ВалидаторJSONSchema = Неопределено Тогда
		Схема = ПолучитьСхемуИзСценария(Контекст.Выполнение.Сценарий);
		ДочерниеСхемы = ПолучитьДочерниеСхемыИзСценария(Контекст.Выполнение.Сценарий);
		ВалидаторJSONSchema = ИнициализироватьВалидаторJSONSchema(Схема, ДочерниеСхемы);
	КонецЕсли;

	Валидация(Контекст.Вход.Сообщение.ТелоСообщения, ВалидаторJSONSchema);
	Если НЕ ИзолированныйВызов Тогда
		ПередатьДругому(Контекст, Вход);
	КонецЕсли;

	Возврат Вход;

КонецФункции
// Проверяет JSON с помощью инициализированной компоненты JSON Schema.
//
// Параметры:
//  JSONДляПроверки - Строка - JSON для проверки.
//  КомпонентаJSONSchema - ОбъектВнешнейКомпоненты - компонента с установленной схемой.
Процедура Валидация(JSONДляПроверки, КомпонентаJSONSchema) Экспорт

	БуферОшибок = Неопределено;

	Попытка
		JSONДействителен = КомпонентаJSONSchema.Проверить(JSONДляПроверки, БуферОшибок);
	Исключение
		ОписаниеОшибкиКомпоненты = КомпонентаJSONSchema.ПолучитьПоследнююОшибку();

		Если Не ЗначениеЗаполнено(ОписаниеОшибкиКомпоненты) Тогда
			ОписаниеОшибкиКомпоненты = ОписаниеОшибки();
		КонецЕсли;

		ВызватьИсключение СтрШаблон("Ошибка проверки JSON: %1", ОписаниеОшибкиКомпоненты);
	КонецПопытки;

	Если Не JSONДействителен Тогда
		ОписаниеВалидации = ?(ЗначениеЗаполнено(БуферОшибок), БуферОшибок, "Причина не указана.");
		ВызватьИсключение СтрШаблон("JSON не соответствует схеме:%1%2", Символы.ПС, ОписаниеВалидации);
	КонецЕсли;

КонецПроцедуры
#КонецОбласти
#Область СлужебныеПроцедурыИФункции
// Получает текст JSON Schema из макета, указанного в сценарии.
Функция ПолучитьСхемуИзСценария(Сценарий)

	СхемаМета = Неопределено;

	Если Не Сценарий.Свойство("СхемаМета", СхемаМета) Тогда
		ВызватьИсключение "В сценарии не указано свойство СхемаМета.";
	КонецЕсли;

	Если СхемаМета = Неопределено Тогда
		ВызватьИсключение "В сценарии не указан макет JSON Schema.";
	КонецЕсли;

	Возврат ПолучитьТекстСхемы(СхемаМета);

КонецФункции
// Получает тексты дочерних JSON Schema из макетов, указанных в сценарии.
Функция ПолучитьДочерниеСхемыИзСценария(Сценарий)

	Результат = Новый Массив;
	ДочерниеСхемыМета = Неопределено;

	Если Не Сценарий.Свойство("ДочерниеСхемыМета", ДочерниеСхемыМета) Тогда
		Возврат Результат;
	КонецЕсли;

	Если ДочерниеСхемыМета = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ДочерняяСхемаМета Из ДочерниеСхемыМета Цикл
		Если ДочерняяСхемаМета = Неопределено Тогда
			ВызватьИсключение "В массиве дочерних JSON Schema не указан макет.";
		КонецЕсли;

		Результат.Добавить(ПолучитьТекстСхемы(ДочерняяСхемаМета));
	КонецЦикла;

	Возврат Результат;

КонецФункции
// Получает текст JSON Schema из макета обработчика.
Функция ПолучитьТекстСхемы(СхемаМета)

	ВладелецСхемыМета = СхемаМета.Родитель();
	ОбработкаСхемы = Обработки[ВладелецСхемыМета.Имя].Создать();
	МакетСхемы = ОбработкаСхемы.ПолучитьМакет(СхемаМета.Имя);

	Возврат МакетСхемы.ПолучитьТекст();

КонецФункции
// Подключает внешнюю компоненту, добавляет дочерние схемы и компилирует основную.
Функция ИнициализироватьВалидаторJSONSchema(Схема, ДочерниеСхемы)

	Если Не ЗначениеЗаполнено(Схема) Тогда
		ВызватьИсключение "Макет JSON Schema не содержит текста схемы.";
	КонецЕсли;

	ПутьККомпоненте = "ОбщийМакет.КОД_КомпонентаJsonschema_1c";
	КомпонентаПодключена = ПодключитьВнешнююКомпоненту(ПутьККомпоненте, "JsonСхема", ТипВнешнейКомпоненты.Native);

	Если Не КомпонентаПодключена Тогда
		ВызватьИсключение СтрШаблон("Не удалось подключить внешнюю компоненту %1.", ПутьККомпоненте);
	КонецЕсли;

	Компонента = Новый("AddIn.JsonСхема.JsonSchema1C");
	Компонента.ИспользоватьДопФорматы = Ложь;
	Компонента.Формат = "Ошибка валидации: {error} в поле: {path}";
	НомерСхемы = 0;

	Для Каждого ДочерняяСхема Из ДочерниеСхемы Цикл
		НомерСхемы = НомерСхемы + 1;

		Попытка
			Компонента.ДобавитьСхему(ДочерняяСхема);
		Исключение
			ОписаниеОшибкиКомпоненты = Компонента.ПолучитьПоследнююОшибку();

			Если Не ЗначениеЗаполнено(ОписаниеОшибкиКомпоненты) Тогда
				ОписаниеОшибкиКомпоненты = ОписаниеОшибки();
			КонецЕсли;

			ВызватьИсключение СтрШаблон("Ошибка инициализации дочерней JSON Schema №%1: %2", НомерСхемы,
				ОписаниеОшибкиКомпоненты);
		КонецПопытки;
	КонецЦикла;

	Попытка
		Компонента.УстановитьОсновнуюСхему(Схема);
	Исключение
		ОписаниеОшибкиКомпоненты = Компонента.ПолучитьПоследнююОшибку();

		Если Не ЗначениеЗаполнено(ОписаниеОшибкиКомпоненты) Тогда
			ОписаниеОшибкиКомпоненты = ОписаниеОшибки();
		КонецЕсли;

		ВызватьИсключение СтрШаблон("Ошибка инициализации JSON Schema: %1", ОписаниеОшибкиКомпоненты);
	КонецПопытки;

	Возврат Компонента;

КонецФункции
// Передает результат текущего обработчика следующему обработчику цепочки.
// В режиме отладки сохраняет результат в контексте без продолжения цепочки.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Выход - Произвольный - результат текущего обработчика.
Процедура ПередатьДругому(Контекст, Выход = Неопределено)

	Если Контекст.Выполнение.Режим = "Отладка" Тогда
		Контекст.Данные.ВыходыОтладки.Добавить(Выход);

		Возврат;
	КонецЕсли;

	Если СледующийОбработчик = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СледующийОбработчик.Обработать(Контекст, Выход);

КонецПроцедуры
#КонецОбласти
