#Область ПрограммныйИнтерфейс

// Выполняет необходимые обновления и начальное заполнение демо-данных.
Процедура ВыполнитьОбновление() Экспорт

	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Обновление демо-данных должно вызываться вне транзакции.";
	КонецЕсли;

	ТребуемаяВерсия = 5;

	Если Константы.Демо_КОД_ВерсияДанных.Получить() >= ТребуемаяВерсия Тогда
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();

	Попытка
		ЗаблокироватьВерсиюДанных();
		ТекущаяВерсия = Константы.Демо_КОД_ВерсияДанных.Получить();

		Если ТекущаяВерсия < 1 Тогда
			Демо_КОД_НачальноеЗаполнение.ВыполнитьВерсию1();
			ТекущаяВерсия = 1;
		КонецЕсли;

		Если ТекущаяВерсия < 2 Тогда
			Демо_КОД_НачальноеЗаполнение.ВыполнитьВерсию2();
			ТекущаяВерсия = 2;
		КонецЕсли;

		Если ТекущаяВерсия < 3 Тогда
			Демо_КОД_НачальноеЗаполнение.ВыполнитьВерсию3();
			ТекущаяВерсия = 3;
		КонецЕсли;

		Константы.Демо_КОД_ВерсияДанных.Установить(ТекущаяВерсия);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("Демо_КОД_НачальноеЗаполнение", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;

	Если ТекущаяВерсия >= ТребуемаяВерсия Тогда
		Возврат;
	КонецЕсли;

	// Для базы версии 4 только добавляем справочники, сохраняя ожидающие сообщения.
	Если ТекущаяВерсия < 4 Тогда
		// Сообщения уже зафиксированы. Ошибка отдельного загрузчика может откатить
		// его транзакцию, но не генерацию и не сохраненную версию 3.
		Попытка
			Демо_КОД_НачальноеЗаполнение.ЗагрузитьНачальныеСообщения();
		Исключение
			ЗаписьЖурналаРегистрации("Демо_КОД_НачальноеЗаполнение", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьВерсиюДанных();
		Если Константы.Демо_КОД_ВерсияДанных.Получить() < 4 Тогда
			Демо_КОД_НачальноеЗаполнение.ВыполнитьВерсию4();
			Константы.Демо_КОД_ВерсияДанных.Установить(4);
		КонецЕсли;
		Если Константы.Демо_КОД_ВерсияДанных.Получить() < 5 Тогда
			Демо_КОД_НачальноеЗаполнение.ВыполнитьВерсию5();
			Константы.Демо_КОД_ВерсияДанных.Установить(5);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("Демо_КОД_НачальноеЗаполнение", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Устанавливает исключительную блокировку значения версии демо-данных.
Процедура ЗаблокироватьВерсиюДанных()

	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("Константа.Демо_КОД_ВерсияДанных");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаДанных.Заблокировать();

КонецПроцедуры

#КонецОбласти
