#Область ПрограммныйИнтерфейс

// Выполняет начальное заполнение демо-данных версии 1.
Процедура ВыполнитьВерсию1() Экспорт

	Категории = ЗаполнитьКатегории();
	Склады = ЗаполнитьСклады();
	Товары = ЗаполнитьТовары(Категории);
	ЗаполнитьПланОбмена(Склады);
	ЗаполнитьЗаказы(Склады, Товары);

КонецПроцедуры

// Добавляет демонстрационные входящие сообщения. Вызывается только шагом обновления
// в общей транзакции под блокировкой версии данных. Саму загрузку не запускает.
Процедура ВыполнитьВерсию2() Экспорт

	ЗаполнитьВходящуюОчередь();

КонецПроцедуры

// Первая дополнительная пачка заказов: корректные документы и ошибки загрузчиков.
// Выполняется в транзакции обновления до версии 3.
Процедура ВыполнитьВерсию3() Экспорт

	ЗаполнитьПервуюПачкуЗаказов();

КонецПроцедуры

// Вторая пачка остается во входящей очереди после автоматической загрузки первой.
// Выполняется в транзакции обновления до версии 4.
Процедура ВыполнитьВерсию4() Экспорт

	ЗаполнитьВторуюПачкуЗаказов();

КонецПроцедуры

// Дополняет вторую пачку товарами и складами, включая базы с уже выполненной версией 4.
// Выполняется в транзакции обновления до версии 5, загрузку не запускает.
Процедура ВыполнитьВерсию5() Экспорт

	ЗаполнитьВторуюПачкуСправочников();

КонецПроцедуры

// Загружает только начальные демо-сообщения версий 2 и 3. Вызывается вне транзакции.
// Повторный запуск продолжает оставшиеся сообщения, не захватывая вторую пачку.
Процедура ЗагрузитьНачальныеСообщения() Экспорт

	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Начальная загрузка демо-сообщений должна вызываться вне транзакции.";
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Очередь.НомерСообщения, Очередь.Идентификатор, Очередь.Заголовки
		|ИЗ РегистрСведений.КОД_ВходящаяОчередьСообщений КАК Очередь
		|УПОРЯДОЧИТЬ ПО Очередь.НомерСообщения, Очередь.Идентификатор");
	Сообщения = Запрос.Выполнить().Выбрать();
	Пока Сообщения.Следующий() Цикл
		Если НЕ НачальноеДемоСообщение(Сообщения.Заголовки) Тогда
			Продолжить;
		КонецЕсли;

		Ключ = Новый Структура("НомерСообщения, Идентификатор",
			Сообщения.НомерСообщения, Сообщения.Идентификатор);
		// Штатный диспетчер переносит ошибки в регистр и продолжает загрузку.
		КОД_ДиспетчерЗагрузкиСообщений.ПрочитатьВходящуюОчередьСообщений(Ложь, Ключ);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает категории товаров, используемые демо-данными.
//
// Возвращаемое значение:
//  Структура - ссылки на созданные категории товаров.
Функция ЗаполнитьКатегории()

	Категории = Новый Структура;
	Категории.Вставить("Электроника", ПолучитьИлиСоздатьКатегорию("Электроника"));
	Категории.Вставить("БытоваяТехника", ПолучитьИлиСоздатьКатегорию("Бытовая техника"));
	Категории.Вставить("Инструменты", ПолучитьИлиСоздатьКатегорию("Инструменты"));

	Возврат Категории;

КонецФункции

// Создает склады, используемые демо-данными.
//
// Возвращаемое значение:
//  Структура - ссылки на созданные склады.
Функция ЗаполнитьСклады()

	Склады = Новый Структура;
	Склады.Вставить("Основной", ПолучитьИлиСоздатьСклад("Основной склад"));
	Склады.Вставить("Резервный", ПолучитьИлиСоздатьСклад("Резервный склад"));
	Склады.Вставить("Региональный", ПолучитьИлиСоздатьСклад("Региональный склад"));

	Возврат Склады;

КонецФункции

// Создает товары, используемые демо-данными.
//
// Параметры:
//  Категории - Структура - ссылки на категории товаров.
//
// Возвращаемое значение:
//  Структура - ссылки на созданные товары.
Функция ЗаполнитьТовары(Категории)

	Товары = Новый Структура;
	Товары.Вставить("Ноутбук", ПолучитьИлиСоздатьТовар("Ноутбук", Категории.Электроника));
	Товары.Вставить("Смартфон", ПолучитьИлиСоздатьТовар("Смартфон", Категории.Электроника));
	Товары.Вставить("Кофеварка", ПолучитьИлиСоздатьТовар("Кофеварка", Категории.БытоваяТехника));
	Товары.Вставить("Пылесос", ПолучитьИлиСоздатьТовар("Пылесос", Категории.БытоваяТехника));
	Товары.Вставить("Дрель", ПолучитьИлиСоздатьТовар("Дрель", Категории.Инструменты));
	Товары.Вставить("НаборИнструментов", ПолучитьИлиСоздатьТовар("Набор инструментов", Категории.Инструменты));

	Возврат Товары;

КонецФункции

// Заполняет текущий и удаленные узлы демо-плана обмена.
//
// Параметры:
//  Склады - Структура - ссылки на склады демо-данных.
Процедура ЗаполнитьПланОбмена(Склады)

	ЗаполнитьЭтотУзелПланаОбмена();

	СкладыУзла = Новый Массив;
	СкладыУзла.Добавить(Склады.Основной);
	ЗаполнитьУзелПланаОбмена("WEB", "Интернет-магазин", СкладыУзла);

	СкладыУзла = Новый Массив;
	СкладыУзла.Добавить(Склады.Резервный);
	ЗаполнитьУзелПланаОбмена("MARKET", "Маркетплейс", СкладыУзла);

	СкладыУзла = Новый Массив;
	СкладыУзла.Добавить(Склады.Основной);
	СкладыУзла.Добавить(Склады.Региональный);
	ЗаполнитьУзелПланаОбмена("B2B", "B2B-портал", СкладыУзла);

КонецПроцедуры

// Создает заказы, демонстрирующие фильтрацию и маршрутизацию по складам.
//
// Параметры:
//  Склады - Структура - ссылки на склады демо-данных.
//  Товары - Структура - ссылки на товары демо-данных.
Процедура ЗаполнитьЗаказы(Склады, Товары)

	СоставЗаказа = Новый Массив;
	СоставЗаказа.Добавить(НоваяСтрокаЗаказа(Товары.Ноутбук, 1));
	СоставЗаказа.Добавить(НоваяСтрокаЗаказа(Товары.Смартфон, 2));
	СоздатьЗаказ(Склады.Основной, СоставЗаказа, Истина);

	СоставЗаказа = Новый Массив;
	СоставЗаказа.Добавить(НоваяСтрокаЗаказа(Товары.Кофеварка, 1));
	СоставЗаказа.Добавить(НоваяСтрокаЗаказа(Товары.Пылесос, 1));
	СоздатьЗаказ(Склады.Резервный, СоставЗаказа, Истина);

	СоставЗаказа = Новый Массив;
	СоставЗаказа.Добавить(НоваяСтрокаЗаказа(Товары.Дрель, 2));
	СоставЗаказа.Добавить(НоваяСтрокаЗаказа(Товары.НаборИнструментов, 1));
	СоздатьЗаказ(Склады.Региональный, СоставЗаказа, Истина);

	СоставЗаказа = Новый Массив;
	СоставЗаказа.Добавить(НоваяСтрокаЗаказа(Товары.Пылесос, 1));
	СоздатьЗаказ(Склады.Основной, СоставЗаказа, Ложь);

КонецПроцедуры

// Возвращает существующую категорию по наименованию или создает новую.
//
// Параметры:
//  Наименование - Строка - наименование категории.
//
// Возвращаемое значение:
//  СправочникСсылка.Демо_КатегорииТоваров - категория товаров.
Функция ПолучитьИлиСоздатьКатегорию(Наименование)

	Ссылка = Справочники.Демо_КОД_КатегорииТоваров.НайтиПоНаименованию(Наименование, Истина);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Категория = Справочники.Демо_КОД_КатегорииТоваров.СоздатьЭлемент();
	Категория.Наименование = Наименование;
	Категория.Записать();

	Возврат Категория.Ссылка;

КонецФункции

// Возвращает существующий склад по наименованию или создает новый.
//
// Параметры:
//  Наименование - Строка - наименование склада.
//
// Возвращаемое значение:
//  СправочникСсылка.Демо_СкладыХранения - склад хранения.
Функция ПолучитьИлиСоздатьСклад(Наименование)

	Ссылка = Справочники.Демо_КОД_СкладыХранения.НайтиПоНаименованию(Наименование, Истина);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Склад = Справочники.Демо_КОД_СкладыХранения.СоздатьЭлемент();
	Склад.Наименование = Наименование;
	Склад.Записать();

	Возврат Склад.Ссылка;

КонецФункции

// Возвращает существующий товар по наименованию или создает новый.
//
// Параметры:
//  Наименование - Строка - наименование товара.
//  Категория - СправочникСсылка.Демо_КатегорииТоваров - категория товара.
//
// Возвращаемое значение:
//  СправочникСсылка.Демо_Товары - товар.
Функция ПолучитьИлиСоздатьТовар(Наименование, Категория)

	Ссылка = Справочники.Демо_КОД_Товары.НайтиПоНаименованию(Наименование, Истина);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Товар = Ссылка.ПолучитьОбъект();
	Иначе
		Товар = Справочники.Демо_КОД_Товары.СоздатьЭлемент();
	КонецЕсли;

	Товар.Наименование = Наименование;
	Товар.Категория = Категория;
	Товар.Записать();

	Возврат Товар.Ссылка;

КонецФункции

// Заполняет код и наименование текущего узла демо-плана обмена.
Процедура ЗаполнитьЭтотУзелПланаОбмена()

	ЭтотУзел = ПланыОбмена.Демо_КОД_ОбменСайтом.ЭтотУзел().ПолучитьОбъект();
	ЭтотУзел.Код = "ERP";
	ЭтотУзел.Наименование = "Демо ERP";
	ЭтотУзел.Записать();

КонецПроцедуры

// Заполняет существующий узел плана обмена по коду или создает новый.
//
// Параметры:
//  Код - Строка - код узла плана обмена.
//  Наименование - Строка - наименование узла плана обмена.
//  Склады - Массив из СправочникСсылка.Демо_СкладыХранения - склады, используемые для отбора.
Процедура ЗаполнитьУзелПланаОбмена(Код, Наименование, Склады)

	Ссылка = ПланыОбмена.Демо_КОД_ОбменСайтом.НайтиПоКоду(Код);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Узел = Ссылка.ПолучитьОбъект();
	Иначе
		Узел = ПланыОбмена.Демо_КОД_ОбменСайтом.СоздатьУзел();
	КонецЕсли;

	Узел.Код = Код;
	Узел.Наименование = Наименование;
	Узел.ОтборПоСкладам = Истина;
	Узел.Склады.Очистить();

	Для Каждого Склад Из Склады Цикл
		СтрокаСклада = Узел.Склады.Добавить();
		СтрокаСклада.Склад = Склад;
	КонецЦикла;

	Узел.Записать();

КонецПроцедуры

// Создает описание строки заказа.
//
// Параметры:
//  Товар - СправочникСсылка.Демо_Товары - товар строки заказа.
//  Количество - Число - количество товара.
//
// Возвращаемое значение:
//  Структура - товар и количество строки заказа.
Функция НоваяСтрокаЗаказа(Товар, Количество)

	Возврат Новый Структура("Товар, Количество", Товар, Количество);

КонецФункции

// Создает демо-заказ и при необходимости проводит его.
//
// Параметры:
//  Склад - СправочникСсылка.Демо_СкладыХранения - склад заказа.
//  СоставЗаказа - Массив из Структура - товары и количества заказа.
//  Проводить - Булево - признак проведения заказа.
Процедура СоздатьЗаказ(Склад, СоставЗаказа, Проводить)

	Заказ = Документы.Демо_Заказ.СоздатьДокумент();
	Заказ.Склад = Склад;
	Заказ.Дата = ТекущаяДата();

	Для Каждого ДанныеСтроки Из СоставЗаказа Цикл
		СтрокаЗаказа = Заказ.Товары.Добавить();
		СтрокаЗаказа.Товар = ДанныеСтроки.Товар;
		СтрокаЗаказа.Количество = ДанныеСтроки.Количество;
	КонецЦикла;

	Заказ.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);

	Если Проводить Тогда
		Заказ.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		Заказ.Записать();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ВходящиеСообщенияВерсии2

// Номера продолжают существующую очередь; UUID сообщений не совпадают с UUID объектов.
// Ссылки объектов фиксированы, чтобы последовательные сообщения показывали обновление.
Процедура ЗаполнитьВходящуюОчередь()

	НачальныйНомер = ПоследнийНомерСообщения();
	Набор = РегистрыСведений.КОД_ВходящаяОчередьСообщений.СоздатьНаборЗаписей();

	Склад = ДемоСсылкаJSON("bce02002-0001-4000-8000-000000000001", "INWH00001", "Входящий склад");
	Склад2 = ДемоСсылкаJSON("bce02002-0001-4000-8000-000000000002", "INWH00002", "Входящий резерв");
	Склады = Новый Массив;
	Склады.Добавить(Склад);
	Склады.Добавить(Склад2);
	ДобавитьДемоСообщение(Набор, НачальныйНомер, "warehouse-create", "warehouse", Склады, "Успех: два склада");

	Склад.name = "Входящий склад обновлен";
	ДобавитьДемоСообщение(Набор, НачальныйНомер, "warehouse-update", "warehouse",
		ДемоМассив(Склад), "Успех: обновление склада по GUID");

	Категория = ДемоСсылкаJSON("bce02002-0002-4000-8000-000000000001", "INCAT0001", "Входящая категория");
	Товар = ДемоСсылкаJSON("bce02002-0003-4000-8000-000000000001", "INPR00001", "Входящий товар");
	Товар.Вставить("category", Категория);
	Товар2 = ДемоСсылкаJSON("bce02002-0003-4000-8000-000000000002", "INPR00002", "Второй входящий товар");
	Товары = Новый Массив;
	Товары.Добавить(Товар);
	Товары.Добавить(Товар2);
	ДобавитьДемоСообщение(Набор, НачальныйНомер, "product-create", "product", Товары,
		"Успех: два товара и вложенная категория");

	Товар.Удалить("category");
	Товар.name = "Входящий товар обновлен";
	ДобавитьДемоСообщение(Набор, НачальныйНомер, "product-keep-category", "product",
		ДемоМассив(Товар), "Успех: категория сохранена");

	// ЗаписатьJSON преобразует Неопределено в JSON null; тип Null не поддерживается.
	Товар.Вставить("category", Неопределено);
	ДобавитьДемоСообщение(Набор, НачальныйНомер, "product-clear-category", "product",
		ДемоМассив(Товар), "Успех: категория очищена");

	СтрокиЗаказа = Новый Массив;
	СтрокиЗаказа.Добавить(Новый Структура("line_number, product, quantity", 1, Товар, 2));
	СтрокиЗаказа.Добавить(Новый Структура("line_number, product, quantity", 2, Товар2, 1.5));
	СтрокиЗаказа.Добавить(Новый Структура("line_number, product, quantity", 3, Товар, 1));
	Заказ = Новый Структура;
	Заказ.Вставить("guid", "bce02002-0004-4000-8000-000000000001");
	Заказ.Вставить("number", "IN0000001");
	Заказ.Вставить("date", "2026-09-01T12:00:00");
	Заказ.Вставить("posted", Истина);
	Заказ.Вставить("warehouse", Склад);
	Заказ.Вставить("items", СтрокиЗаказа);
	ДобавитьДемоСообщение(Набор, НачальныйНомер, "order-create", "order", Заказ,
		"Успех: склад, товары, номер, дата и строки заказа");

	ДобавитьДемоСообщение(Набор, НачальныйНомер, "product-empty", "product", Новый Массив,
		"Успех: пустой массив без записи объектов");

	ДобавитьДемоСообщение(Набор, НачальныйНомер, "json-broken", "product", "[{",
		"Ошибка чтения JSON", "WEB", Истина);

	НеполныйТовар = Новый Структура("guid, code", Товар.guid, Товар.code);
	ДобавитьДемоСообщение(Набор, НачальныйНомер, "schema-required", "product",
		ДемоМассив(НеполныйТовар), "Ошибка схемы: отсутствует name");

	НеверныйТовар = ДемоСсылкаJSON(Товар.guid, Товар.code, 123);
	ДобавитьДемоСообщение(Набор, НачальныйНомер, "schema-type", "product",
		ДемоМассив(НеверныйТовар), "Ошибка схемы: name должен быть строкой");

	НеверныйТовар = ДемоСсылкаJSON("not-a-guid", "INERR0001", "Неверный GUID");
	ДобавитьДемоСообщение(Набор, НачальныйНомер, "schema-guid", "product",
