Функция ДемоСсылкаJSON(Идентификатор, Код, Наименование)

	Возврат Новый Структура("guid, code, name", Идентификатор, Код, Наименование);

КонецФункции

Функция ДемоМассив(Элемент)

	Результат = Новый Массив;
	Результат.Добавить(Элемент);
	Возврат Результат;

КонецФункции

// Сериализация выполняется сразу: изменение структуры для следующего примера
// не меняет уже подготовленное тело. Ожидание относится к первичной загрузке.
Процедура ДобавитьДемоСообщение(Набор, НачальныйНомер, КодПримера, ТипСообщения, Данные,
	ОжидаемыйРезультат, Отправитель = "WEB", ГотовыйJSON = Ложь, ВерсияДанных = 2)

	Заголовки = Новый Структура;
	Заголовки.Вставить("content_type", "application/json");
	Заголовки.Вставить("demo_version", ВерсияДанных);
	Заголовки.Вставить("demo_case", КодПримера);
	Заголовки.Вставить("expected_result", ОжидаемыйРезультат);

	Запись = Набор.Добавить();
	Запись.НомерСообщения = НачальныйНомер + Набор.Количество();
	Запись.Идентификатор = Новый УникальныйИдентификатор;
	Запись.ДатаВремя = ТекущаяДата();
	Запись.Отправитель = Отправитель;
	Запись.ТипСообщения = ТипСообщения;
	Запись.Заголовки = ДемоСтрокаJSON(Заголовки);
	Если ГотовыйJSON Тогда
		Запись.ТелоСообщения = Данные;
	Иначе
		Запись.ТелоСообщения = ДемоСтрокаJSON(Данные);
	КонецЕсли;

КонецПроцедуры

Функция ДемоСтрокаJSON(Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

