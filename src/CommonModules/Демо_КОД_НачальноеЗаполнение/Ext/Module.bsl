		"Ошибка чтения JSON заказа", "WEB", Истина);

	Заказ = ДемоЗаказJSON(104, Данные.РезервныйСклад, ДемоМассив(ДемоСтрокаЗаказаJSON(1, Данные.Товар2, 4)));
	ДобавитьДемоЗаказ(Набор, НачальныйНомер, ВерсияДанных, "pending-order-after-errors", Заказ,
		"Успех: корректный заказ после ошибок второй пачки");

	Набор.Записать(Ложь);

КонецПроцедуры

Функция ДемоДанныеЗаказов()

	Данные = Новый Структура;
	Данные.Вставить("Склад", ДемоСсылкаJSON("bce02003-0001-4000-8000-000000000001", "D3WH00001", "Склад новых заказов"));
	Данные.Вставить("РезервныйСклад", ДемоСсылкаJSON("bce02003-0001-4000-8000-000000000002", "D3WH00002", "Резерв новых заказов"));
	Данные.Вставить("Товар", ДемоСсылкаJSON("bce02003-0003-4000-8000-000000000001", "D3PR00001", "Товар новых заказов"));
	Данные.Вставить("Товар2", ДемоСсылкаJSON("bce02003-0003-4000-8000-000000000002", "D3PR00002", "Второй товар заказов"));
	Возврат Данные;

КонецФункции

Функция ДемоЗаказJSON(Номер, Склад, Строки = Неопределено)

	Если Строки = Неопределено Тогда
		Строки = Новый Массив;
	КонецЕсли;

	Заказ = Новый Структура;
	Заказ.Вставить("guid", "bce02003-0004-4000-8000-" + Прав("000000000000" + Строка(Номер), 12));
	Заказ.Вставить("number", "IN3" + Прав("000000" + Строка(Номер), 6));
	Заказ.Вставить("date", "2026-09-02T12:00:00");
	Заказ.Вставить("posted", Истина);
	Заказ.Вставить("warehouse", Склад);
	Заказ.Вставить("items", Строки);
	Возврат Заказ;

КонецФункции

Функция ДемоСтрокаЗаказаJSON(НомерСтроки, Товар, Количество)

	Возврат Новый Структура("line_number, product, quantity", НомерСтроки, Товар, Количество);

КонецФункции

Процедура ДобавитьДемоЗаказ(Набор, НачальныйНомер, ВерсияДанных, КодПримера, Заказ,
	ОжидаемыйРезультат, Отправитель = "WEB", ГотовыйJSON = Ложь)

	ДобавитьДемоСообщение(Набор, НачальныйНомер, КодПримера, "order", Заказ,
		ОжидаемыйРезультат, Отправитель, ГотовыйJSON, ВерсияДанных);

КонецПроцедуры

// После загрузки первая пачка уже удалена из входящей очереди, но ее ошибки остались.
Функция ПоследнийНомерСообщения()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(МАКСИМУМ(Номера.НомерСообщения), 0) КАК Номер
		|ИЗ (ВЫБРАТЬ Очередь.НомерСообщения КАК НомерСообщения
		|    ИЗ РегистрСведений.КОД_ВходящаяОчередьСообщений КАК Очередь
		|    ОБЪЕДИНИТЬ ВСЕ
		|    ВЫБРАТЬ Ошибки.НомерСообщения
		|    ИЗ РегистрСведений.КОД_ОшибкиЗагрузкиСообщений КАК Ошибки) КАК Номера");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Номер;

КонецФункции

Функция НачальноеДемоСообщение(СтрокаЗаголовков)

	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.УстановитьСтроку(СтрокаЗаголовков);
		Заголовки = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		Возврат Ложь;
	КонецПопытки;
	Чтение.Закрыть();

	Если ТипЗнч(Заголовки) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат (Заголовки["demo_version"] = 2 Или Заголовки["demo_version"] = 3)
		И ТипЗнч(Заголовки["demo_case"]) = Тип("Строка");

КонецФункции

#КонецОбласти
