// Модуль внешней обработки: вызвать ВыполнитьПроверки() на сервере в demo.
// Не записывает объекты и не отправляет сообщения. Работает с временными таблицами.
Процедура ВыполнитьПроверки() Экспорт

	Отправитель = ПланыОбмена.Демо_КОД_ОбменСайтом.ПолучитьСсылку(
		Новый УникальныйИдентификатор("11111111-1111-1111-1111-111111111111"));
	ДругойУзел = ПланыОбмена.Демо_КОД_ОбменСайтом.ПолучитьСсылку(
		Новый УникальныйИдентификатор("22222222-2222-2222-2222-222222222222"));
	Ссылка = Документы.Демо_Заказ.ПолучитьСсылку(Новый УникальныйИдентификатор("33333333-3333-3333-3333-333333333333"));

	ПроверитьМаршруты(Отправитель, ДругойУзел, Ссылка, Ложь, Истина, 1);
	ПроверитьМаршруты(Отправитель, ДругойУзел, Ссылка, Истина, Ложь, 2);
	ПроверитьМаршруты(Отправитель, ДругойУзел, Ссылка, Неопределено, Истина, 2);
	ПроверитьМаршруты(Отправитель, ДругойУзел, Ссылка, Неопределено, Ложь, 1);
	ПроверитьМаршруты(Отправитель, ДругойУзел, Ссылка, Неопределено, Неопределено, 1);
	ПроверитьМаршруты(Отправитель, ДругойУзел, Ссылка, Ложь, Ложь, 0, Истина);
	ПроверитьМаршруты(Отправитель, ДругойУзел, Ссылка, Ложь, Ложь, 2, Ложь, Истина);

	// Отсутствие контекста операции (старые ручные вызовы) не ограничивает получателей.
	Контекст = Новый Структура("Данные, Выполнение", Новый Структура, Новый Структура("Сценарий", Новый Структура));
	Проверить(КОД_ДиспетчерРегистрацииКОбмену.ИсключаемыйОтправитель(Контекст)
		= Неопределено, "Старый вызов без параметров операции");

	// Обработчик обнаруживает неверный порядок этапов даже без отправителя.
	Контекст.Выполнение.Вставить("ИзолированныйВызов", Ложь);
	Контекст.Выполнение.Вставить("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц);
	ОшибкаПолучена = Ложь;

	Попытка
		Обработки.КОД_Обработчик_ИсключениеОтправителя.Создать().Обработать(Контекст);
	Исключение
		ОшибкаПолучена = Истина;
	КонецПопытки;

	Проверить(ОшибкаПолучена, "Отсутствует результат маршрутизации");
	Контекст.Выполнение.МенеджерВременныхТаблиц.Закрыть();

	// Товар не входит в состав плана обмена; Загрузка остается Ложь.
	Объект = Справочники.Демо_КОД_Товары.СоздатьЭлемент();
	Объект.ДополнительныеСвойства.Вставить("КОД_Отправитель", Отправитель);
	Объект.ДополнительныеСвойства.Вставить("КОД_ОтправлятьОбратноОтправителю", Истина);
	Параметры = КОД_ДиспетчерРегистрацииКОбмену.ПараметрыРегистрацииИзОбъекта(Объект);
	Проверить(Параметры.Отправитель = Отправитель, "Снятие отправителя с объекта");
	Проверить(Параметры.ОтправлятьОбратноОтправителю = Истина, "Явное разрешение объекта");
	Объект.ДополнительныеСвойства.Удалить("КОД_ОтправлятьОбратноОтправителю");
	Параметры = КОД_ДиспетчерРегистрацииКОбмену.ПараметрыРегистрацииИзОбъекта(Объект);
	Проверить(Параметры.ОтправлятьОбратноОтправителю = Неопределено, "Наследование политики");

	Объект.ДополнительныеСвойства.Удалить("КОД_Отправитель");
	Параметры = КОД_ДиспетчерРегистрацииКОбмену.ПараметрыРегистрацииИзОбъекта(Объект);
	Проверить(Параметры.Отправитель = Неопределено, "Локальная запись без отправителя");

	// Очередь хранит снимок; следующее задание не наследует отправителя.
	Очередь = КОД_ДиспетчерРегистрацииКОбмену.НовыйКонтекстРегистрации(Новый Соответствие);

	Ссылки = Новый Массив;
	Ссылки.Добавить(Ссылка);

	Параметры = Новый Структура("Отправитель, ОтправлятьОбратноОтправителю", Отправитель, Ложь);
	КОД_ДиспетчерРегистрацииКОбмену.ДобавитьЗаданиеРегистрации(
		Очередь, Метаданные.Документы.Демо_Заказ, Ссылки, Неопределено, Параметры);
	Параметры.Отправитель = ДругойУзел;
	КОД_ДиспетчерРегистрацииКОбмену.ДобавитьЗаданиеРегистрации(Очередь, Метаданные.Документы.Демо_Заказ, Ссылки);
	Проверить(Очередь.ОчередьРегистрации[0].ПараметрыРегистрации.Отправитель = Отправитель,
		"Снимок параметров задания");
	Проверить(Очередь.ОчередьРегистрации[1].ПараметрыРегистрации = Неопределено,
		"Связанная регистрация без наследования отправителя");
	Очередь.МенеджерВременныхТаблиц.Закрыть();

	Сообщить("Проверки регистрации с учетом отправителя выполнены.");

КонецПроцедуры

Процедура ПроверитьМаршруты(Отправитель, ДругойУзел, Ссылка, Решение, Умолчание,
	ОжидаемоеКоличество, ТолькоОтправитель = Ложь, ПустойОтправитель = Ложь)

	МВТ = Новый МенеджерВременныхТаблиц;
	Маршруты = Новый ТаблицаЗначений;
	Маршруты.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.Демо_Заказ"));
	Маршруты.Колонки.Добавить("Узел", Новый ОписаниеТипов("ПланОбменаСсылка.Демо_КОД_ОбменСайтом"));
	Маршруты.Колонки.Добавить("Маркер", Новый ОписаниеТипов("Строка"));
	Строка = Маршруты.Добавить();
	Строка.Ссылка = Ссылка;
	Строка.Узел = Отправитель;
	Строка.Маркер = "исходный";

	Если НЕ ТолькоОтправитель Тогда
		Строка = Маршруты.Добавить();
		Строка.Ссылка = Ссылка;
		Строка.Узел = ДругойУзел;
		Строка.Маркер = "сохранить";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.УстановитьПараметр("Маршруты", Маршруты);

	Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_СсылкиПоУзлам ИЗ &Маршруты КАК Маршруты";
	Запрос.Выполнить();

	Сценарий = Новый Структура;

	Если Умолчание <> Неопределено Тогда
		Сценарий.Вставить("ОтправлятьОбратноОтправителю", Умолчание);
	КонецЕсли;

	Параметры = Новый Структура("Отправитель, ОтправлятьОбратноОтправителю",
		?(ПустойОтправитель, ПланыОбмена.Демо_КОД_ОбменСайтом.ПустаяСсылка(), Отправитель), Решение);

	Контекст = Новый Структура("Данные, Выполнение", Новый Структура("ПараметрыРегистрации", Параметры),
		Новый Структура("Сценарий, МенеджерВременныхТаблиц", Сценарий, МВТ));
	Контекст.Выполнение.Вставить("ИзолированныйВызов", Ложь);
	Обработчик = Обработки.КОД_Обработчик_ИсключениеОтправителя.Создать();
	Обработчик.Обработать(Контекст);

	// Повторный запуск не меняет результат и не конфликтует с рабочей таблицей.
	Обработчик.Обработать(Контекст);

	Запрос.Текст = "ВЫБРАТЬ * ИЗ ВТ_СсылкиПоУзлам";
	Результат = Запрос.Выполнить().Выгрузить();
	Проверить(Результат.Количество() = ОжидаемоеКоличество, "Количество маршрутов");

	Если ОжидаемоеКоличество = 1 Тогда
		Проверить(Результат[0].Узел = ДругойУзел, "Исключен именно отправитель");
		Проверить(Результат[0].Ссылка = Ссылка, "Сохранена ссылка объекта");
		Проверить(Результат[0].Маркер = "сохранить", "Сохранены дополнительные колонки");
	КонецЕсли;

	Проверить(НЕ КОД_ДиспетчерРегистрацииКОбмену.ВременнаяТаблицаСуществует(
		МВТ, "ВТ_КОД_МаршрутыБезОтправителя"), "Удалена рабочая таблица");
	МВТ.Закрыть();

КонецПроцедуры

Процедура Проверить(Условие, Описание)

	Если НЕ Условие Тогда
		ВызватьИсключение "Не пройдена проверка: " + Описание;
	КонецЕсли;

КонецПроцедуры
