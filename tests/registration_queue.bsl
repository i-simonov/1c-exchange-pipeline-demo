// Модуль внешней обработки для тестовой demo-базы.
// Запускать ВыполнитьПроверки() на сервере вне транзакции, при остановленной доставке.
// Все созданные объекты и исходящие сообщения откатываются транзакцией теста.
Процедура ВыполнитьПроверки() Экспорт

	Проверить(НЕ ТранзакцияАктивна(), "Запуск вне транзакции");
	ПроверитьОбязательныйРеестр();

	НачатьТранзакцию();
	Попытка
		Узел = ПланыОбмена.Демо_КОД_ОбменСайтом.СоздатьУзел();
		Узел.Код = "T" + Лев(Строка(Новый УникальныйИдентификатор), 8);
		Узел.Наименование = "Тест очереди регистрации";
		Узел.ОтборПоСкладам = Ложь;
		Узел.Записать();

		Склад = Справочники.Демо_КОД_СкладыХранения.СоздатьЭлемент();
		Склад.Наименование = "Тест очереди регистрации";
		Склад.Записать();
		Товар = Справочники.Демо_КОД_Товары.СоздатьЭлемент();
		Товар.Наименование = "Тест связанной регистрации";
		Товар.Записать();

		Заказ = Документы.Демо_Заказ.СоздатьДокумент();
		Заказ.Дата = ТекущаяДата();
		Заказ.Склад = Склад.Ссылка;
		Заказ.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
		СтрокаТовара = Заказ.Товары.Добавить();
		СтрокаТовара.Товар = Товар.Ссылка;
		СтрокаТовара.Количество = 1;
		Заказ.Записать(РежимЗаписиДокумента.Проведение);

		ПроверитьСвязаннуюРегистрацию(Заказ.Ссылка, Товар.Ссылка, Узел.Ссылка);
		ПроверитьВыборОбработчиков(Заказ.Ссылка, Узел.Ссылка);
		ПроверитьПустойРеестр(Заказ.Ссылка, Узел.Ссылка);
		ПроверитьПустуюОчередь(Узел.Ссылка);
		ПроверитьНесколькоСценариев(Заказ.Ссылка, Узел.Ссылка);
		ПроверитьЗаписьЗаказа(Заказ, Узел.Ссылка);
		ПроверитьПакетнуюСвязаннуюРегистрацию(Заказ, Товар.Ссылка, Узел);
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	ОтменитьТранзакцию();

	Сообщить("Проверки очереди регистрации выполнены.");

КонецПроцедуры

Процедура ПроверитьОбязательныйРеестр()

	ОшибкаПолучена = Ложь;
	Попытка
		КОД_ДиспетчерРегистрацииКОбмену.НовыйКонтекстРегистрации(Неопределено);
	Исключение
		ОшибкаПолучена = СтрНайти(ОписаниеОшибки(), "Необходимо передать готовый реестр") > 0;
	КонецПопытки;
	Проверить(ОшибкаПолучена, "Неопределено не подменяется стандартным реестром");

КонецПроцедуры

Процедура ПроверитьСвязаннуюРегистрацию(Заказ, Товар, Узел)

	Реестр = РеестрДляУзла(Узел);
	Контекст = КонтекстДляЗаказа(Реестр, Заказ);
	ДоЗаказов = КоличествоСообщений(Узел, "Документ.Демо_Заказ");
	ДоТоваров = КоличествоСообщений(Узел, "Справочник.Демо_КОД_Товары");
	Результаты = КОД_ДиспетчерРегистрацииКОбмену.ВыполнитьЗаданияРегистрации(Контекст, Истина);

	Проверить(Контекст.ОчередьРегистрации.Количество() = 2, "Связанное задание добавлено обработчиком");
	Проверить(Результаты.Количество() = 2, "Выполнены только сценарии выбранного плана: заказ и товар");
	Проверить(Результаты[0].Количество() = 1 И Результаты[0][0].Ссылка = Заказ,
		"Снимок результата заказа сохранен до выполнения товара");
	Проверить(Результаты[1].Количество() = 1 И Результаты[1][0].Ссылка = Товар,
		"Связанное задание выполнено в том же запуске");
	Проверить(Результаты[0][0].Узел = Узел И Результаты[1][0].Узел = Узел,
		"Связанный товар ограничен маршрутом заказа");
	Проверить(КоличествоСообщений(Узел, "Документ.Демо_Заказ") = ДоЗаказов + 1,
		"Сообщение заказа записано в исходящую очередь");
	Проверить(КоличествоСообщений(Узел, "Справочник.Демо_КОД_Товары") = ДоТоваров + 1,
		"Сообщение связанного товара записано в исходящую очередь");
	ПроверитьОчисткуТаблиц(Контекст);
	Контекст.МенеджерВременныхТаблиц.Закрыть();

КонецПроцедуры

// Два заказа имеют разные узлы; общий товар должен попасть в оба, отдельные — только в свой.
Процедура ПроверитьПакетнуюСвязаннуюРегистрацию(Заказ1, Товар1, Узел1)

	Узел1.ОтборПоСкладам = Истина;
	СтрокаСклада = Узел1.Склады.Добавить();
	СтрокаСклада.Склад = Заказ1.Склад;
	Узел1.Записать();

	Склад2 = Справочники.Демо_КОД_СкладыХранения.СоздатьЭлемент();
	Склад2.Наименование = "Второй склад пакетной регистрации";
	Склад2.Записать();
	Узел2 = ПланыОбмена.Демо_КОД_ОбменСайтом.СоздатьУзел();
	Узел2.Код = "T" + Лев(Строка(Новый УникальныйИдентификатор), 8);
	Узел2.Наименование = "Второй узел пакетной регистрации";
	Узел2.ОтборПоСкладам = Истина;
	СтрокаСклада = Узел2.Склады.Добавить();
	СтрокаСклада.Склад = Склад2.Ссылка;
	Узел2.Записать();

	Товар2 = Справочники.Демо_КОД_Товары.СоздатьЭлемент();
	Товар2.Наименование = "Товар только второго заказа";
	Товар2.Записать();
	ОбщийТовар = Справочники.Демо_КОД_Товары.СоздатьЭлемент();
	ОбщийТовар.Наименование = "Общий товар двух заказов";
	ОбщийТовар.Записать();

	Заказ1.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
	ДобавитьТоварВТестовыйЗаказ(Заказ1, ОбщийТовар.Ссылка);
	ДобавитьТоварВТестовыйЗаказ(Заказ1, ОбщийТовар.Ссылка);
	Заказ1.Записать(РежимЗаписиДокумента.Проведение);
	Заказ2 = Документы.Демо_Заказ.СоздатьДокумент();
	Заказ2.Дата = ТекущаяДата();
	Заказ2.Склад = Склад2.Ссылка;
	Заказ2.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
	ДобавитьТоварВТестовыйЗаказ(Заказ2, Товар2.Ссылка);
	ДобавитьТоварВТестовыйЗаказ(Заказ2, ОбщийТовар.Ссылка);
	Заказ2.Записать(РежимЗаписиДокумента.Проведение);

	Реестр = РеестрДляУзла(Узел1.Ссылка);
	РеестрПлана = Реестр[Метаданные.ПланыОбмена.Демо_КОД_ОбменСайтом];
	СценарииЗаказов = РеестрПлана[Метаданные.Документы.Демо_Заказ];
	СценарииЗаказов[0].КодыУзлов.Добавить(Узел2.Код);
	Контекст = КОД_ДиспетчерРегистрацииКОбмену.НовыйКонтекстРегистрации(
		Реестр, Неопределено, "РучнаяРегистрация");
	Ссылки = Новый Массив;
	Ссылки.Добавить(Заказ1.Ссылка);
	Ссылки.Добавить(Заказ2.Ссылка);
	КОД_ДиспетчерРегистрацииКОбмену.ДобавитьЗаданиеРегистрации(
		Контекст, Метаданные.Документы.Демо_Заказ, Ссылки);

	ДоТоваров1 = КоличествоСообщений(Узел1.Ссылка, "Справочник.Демо_КОД_Товары");
	ДоТоваров2 = КоличествоСообщений(Узел2.Ссылка, "Справочник.Демо_КОД_Товары");
	Результаты = КОД_ДиспетчерРегистрацииКОбмену.ВыполнитьЗаданияРегистрации(Контекст, Истина);
	Проверить(Контекст.ОчередьРегистрации.Количество() = 3 И Результаты.Количество() = 3,
		"Пакет заказов создает два отдельных задания товаров по узлам");
	Проверить(Результаты[0].Количество() = 2 И Результаты[1].Количество() = 2 И Результаты[2].Количество() = 2,
		"В результатах ровно два маршрута заказов и четыре маршрута товаров");
	Проверить(КоличествоМаршрутов(Результаты, Заказ1.Ссылка, Узел1.Ссылка) = 1
		И КоличествоМаршрутов(Результаты, Заказ2.Ссылка, Узел2.Ссылка) = 1,
		"Исходные заказы направлены каждый на свой узел");
	Проверить(КоличествоМаршрутов(Результаты, Товар1, Узел1.Ссылка) = 1
		И КоличествоМаршрутов(Результаты, Товар1, Узел2.Ссылка) = 0
		И КоличествоМаршрутов(Результаты, Товар2.Ссылка, Узел2.Ссылка) = 1
		И КоличествоМаршрутов(Результаты, Товар2.Ссылка, Узел1.Ссылка) = 0,
		"Товары не получают узлы чужих заказов");
	Проверить(КоличествоМаршрутов(Результаты, ОбщийТовар.Ссылка, Узел1.Ссылка) = 1
		И КоличествоМаршрутов(Результаты, ОбщийТовар.Ссылка, Узел2.Ссылка) = 1,
		"Общий товар получает оба узла без повторов из строк заказа");

	Для ИндексЗадания = 1 По 2 Цикл
		Задание = Контекст.ОчередьРегистрации[ИндексЗадания];
		Проверить(Задание.КодыУзлов.Количество() = 1 И Задание.МассивСсылок.Количество() = 2,
			"Связанное задание содержит один узел и два уникальных товара");
	КонецЦикла;
	Проверить(КоличествоСообщений(Узел1.Ссылка, "Справочник.Демо_КОД_Товары") = ДоТоваров1 + 2
		И КоличествоСообщений(Узел2.Ссылка, "Справочник.Демо_КОД_Товары") = ДоТоваров2 + 2,
		"Каждому узлу записаны только два сообщения его товаров");
	ПроверитьОчисткуТаблиц(Контекст);
	Контекст.МенеджерВременныхТаблиц.Закрыть();

	// Узел2 не принимает склад первого заказа: связанных заданий быть не должно.
	Контекст = КонтекстДляЗаказа(РеестрДляУзла(Узел2.Ссылка), Заказ1.Ссылка);
	Результаты = КОД_ДиспетчерРегистрацииКОбмену.ВыполнитьЗаданияРегистрации(Контекст, Истина);
	Проверить(Контекст.ОчередьРегистрации.Количество() = 1
		И Результаты.Количество() = 1 И Результаты[0].Количество() = 0,
		"Заказ без маршрутов не создает связанных заданий");
	Проверить(КоличествоСообщений(Узел2.Ссылка, "Справочник.Демо_КОД_Товары") = ДоТоваров2 + 2,
		"При отсутствии маршрутов дополнительные сообщения товаров не создаются");
	ПроверитьОчисткуТаблиц(Контекст);
	Контекст.МенеджерВременныхТаблиц.Закрыть();

КонецПроцедуры

Процедура ДобавитьТоварВТестовыйЗаказ(Заказ, Товар)

	СтрокаТовара = Заказ.Товары.Добавить();
	СтрокаТовара.Товар = Товар;
	СтрокаТовара.Количество = 1;

КонецПроцедуры

Функция КоличествоМаршрутов(Результаты, Ссылка, Узел)

	Количество = 0;
	Отбор = Новый Структура("Ссылка, Узел", Ссылка, Узел);
	Для Каждого ТаблицаРезультата Из Результаты Цикл
		Количество = Количество + ТаблицаРезультата.НайтиСтроки(Отбор).Количество();
	КонецЦикла;
	Возврат Количество;

КонецФункции

Процедура ПроверитьВыборОбработчиков(Заказ, Узел)

	Реестр = РеестрДляУзла(Узел);
	РеестрПлана = Реестр[Метаданные.ПланыОбмена.Демо_КОД_ОбменСайтом];
	СценарииЗаказов = РеестрПлана[Метаданные.Документы.Демо_Заказ];
	Обработчики = СценарииЗаказов[0].Обработчики;
	Обработчики.Удалить(Обработчики.Найти(Метаданные.Обработки.Демо_КОД_Обработчик_СвязаннаяРегистрацияТоваров));
	Контекст = КонтекстДляЗаказа(Реестр, Заказ);
	ДоТоваров = КоличествоСообщений(Узел, "Справочник.Демо_КОД_Товары");
	Результаты = КОД_ДиспетчерРегистрацииКОбмену.ВыполнитьЗаданияРегистрации(Контекст, Истина);
	Проверить(Результаты.Количество() = 1 И Контекст.ОчередьРегистрации.Количество() = 1,
		"Снятый обработчик связанной регистрации не восстанавливается из стандартного реестра");
	Проверить(КоличествоСообщений(Узел, "Справочник.Демо_КОД_Товары") = ДоТоваров, "Товары не отправлены");
	Контекст.МенеджерВременныхТаблиц.Закрыть();

	// Связанное задание тоже должно использовать подготовленный реестр, а не стандартный.
	Реестр = РеестрДляУзла(Узел);
	РеестрПлана = Реестр[Метаданные.ПланыОбмена.Демо_КОД_ОбменСайтом];
	СценарииТоваров = РеестрПлана[Метаданные.Справочники.Демо_КОД_Товары];
	Обработчики = СценарииТоваров[0].Обработчики;
	Обработчики.Очистить();
	Обработчики.Добавить(Метаданные.Обработки.Демо_КОД_Обработчик_ФильтрТоваров);
	Контекст = КонтекстДляЗаказа(Реестр, Заказ);
	Результаты = КОД_ДиспетчерРегистрацииКОбмену.ВыполнитьЗаданияРегистрации(Контекст, Истина);
	Проверить(Результаты.Количество() = 2 И Результаты[1].Количество() = 0,
		"Сценарий связанного товара без маршрутизатора возвращает пустой результат");
	Проверить(КоличествоСообщений(Узел, "Справочник.Демо_КОД_Товары") = ДоТоваров,
		"Стандартная цепочка товара не подставляется вместо переданной");
	ПроверитьОчисткуТаблиц(Контекст);
	Контекст.МенеджерВременныхТаблиц.Закрыть();

	// Пустой выбор сценариев исходного объекта не запускает остальные типы из реестра.
	Реестр = РеестрДляУзла(Узел);
	РеестрПлана = Реестр[Метаданные.ПланыОбмена.Демо_КОД_ОбменСайтом];
	РеестрПлана.Вставить(Метаданные.Документы.Демо_Заказ, Новый Массив);
	Контекст = КонтекстДляЗаказа(Реестр, Заказ);
	Результаты = КОД_ДиспетчерРегистрацииКОбмену.ВыполнитьЗаданияРегистрации(Контекст, Истина);
	Проверить(Результаты.Количество() = 0 И Контекст.ОчередьРегистрации.Количество() = 1,
		"Без выбранных сценариев ничего не выполняется");
	Контекст.МенеджерВременныхТаблиц.Закрыть();

КонецПроцедуры

Процедура ПроверитьПустойРеестр(Заказ, Узел)

	Контекст = КонтекстДляЗаказа(Новый Соответствие, Заказ);
	ДоЗаказов = КоличествоСообщений(Узел, "Документ.Демо_Заказ");
	Результаты = КОД_ДиспетчерРегистрацииКОбмену.ВыполнитьЗаданияРегистрации(Контекст, Истина);
	Проверить(Результаты.Количество() = 0, "Пустой реестр не включает глобальные сценарии");
	Проверить(КоличествоСообщений(Узел, "Документ.Демо_Заказ") = ДоЗаказов, "Заказ не отправлен");
	Контекст.МенеджерВременныхТаблиц.Закрыть();

КонецПроцедуры

Процедура ПроверитьПустуюОчередь(Узел)

	Контекст = КОД_ДиспетчерРегистрацииКОбмену.НовыйКонтекстРегистрации(РеестрДляУзла(Узел));
	КОД_ДиспетчерРегистрацииКОбмену.ДобавитьЗаданиеРегистрации(
		Контекст, Метаданные.Документы.Демо_Заказ, Новый Массив);
	Результаты = КОД_ДиспетчерРегистрацииКОбмену.ВыполнитьЗаданияРегистрации(Контекст, Истина);
	Проверить(Результаты.Количество() = 0 И Контекст.ОчередьРегистрации.Количество() = 0,
		"Пустые ссылки не создают задания");
	Контекст.МенеджерВременныхТаблиц.Закрыть();

КонецПроцедуры

Процедура ПроверитьНесколькоСценариев(Заказ, Узел)

	Реестр = РеестрДляУзла(Узел);
	РеестрПлана = Реестр[Метаданные.ПланыОбмена.Демо_КОД_ОбменСайтом];
	Сценарии = РеестрПлана[Метаданные.Документы.Демо_Заказ];
	Сценарии.Добавить(Сценарии[0]);
	Контекст = КонтекстДляЗаказа(Реестр, Заказ);
	Результаты = КОД_ДиспетчерРегистрацииКОбмену.ВыполнитьЗаданияРегистрации(Контекст, Истина);
	Проверить(Результаты.Количество() = 4 И Контекст.ОчередьРегистрации.Количество() = 3,
		"Два сценария заказа и два добавленных задания товара выполняются без конфликта временных таблиц");
	ПроверитьОчисткуТаблиц(Контекст);
	Контекст.МенеджерВременныхТаблиц.Закрыть();

КонецПроцедуры

Процедура ПроверитьЗаписьЗаказа(Заказ, Узел)

	ДоЗаказов = КоличествоСообщений(Узел, "Документ.Демо_Заказ");
	ДоТоваров = КоличествоСообщений(Узел, "Справочник.Демо_КОД_Товары");
	Заказ.ДополнительныеСвойства.Удалить("ОтключитьМеханизмРегистрацииОбъектов");
	Заказ.Записать();
	Проверить(КоличествоСообщений(Узел, "Документ.Демо_Заказ") = ДоЗаказов + 1,
		"Событие записи использует стандартный реестр");
	Проверить(КоличествоСообщений(Узел, "Справочник.Демо_КОД_Товары") = ДоТоваров + 1,
		"Связанные товары регистрируются из события записи");

КонецПроцедуры

Функция РеестрДляУзла(Узел)

	Подключения = Новый Соответствие;
	Подключения.Вставить(Метаданные.ПланыОбмена.Демо_КОД_ОбменСайтом,
		Метаданные.Обработки.Демо_КОД_РеестрСценариевРегистрация_ОбменССайтом);
	Реестр = КОД_ДиспетчерРегистрацииКОбмену.ПолучитьРеестрСценариевРегистрации(Подключения);
	РеестрПлана = Реестр[Метаданные.ПланыОбмена.Демо_КОД_ОбменСайтом];
	Сценарии = РеестрПлана[Метаданные.Документы.Демо_Заказ];
	Сценарий = Новый Структура(Сценарии[0]);
	КодыУзлов = Новый Массив;
	КодыУзлов.Добавить(Узел.Код);
	Сценарий.Вставить("КодыУзлов", КодыУзлов);
	Сценарии[0] = Новый ФиксированнаяСтруктура(Сценарий);

	Возврат Реестр;

КонецФункции

Функция КонтекстДляЗаказа(Реестр, Заказ)

	Контекст = КОД_ДиспетчерРегистрацииКОбмену.НовыйКонтекстРегистрации(
		Реестр, Неопределено, "РучнаяРегистрация");
	Ссылки = Новый Массив;
	Ссылки.Добавить(Заказ);
	КОД_ДиспетчерРегистрацииКОбмену.ДобавитьЗаданиеРегистрации(Контекст, Метаданные.Документы.Демо_Заказ, Ссылки);
	Возврат Контекст;

КонецФункции

Процедура ПроверитьОчисткуТаблиц(Контекст)

	Проверить(НЕ КОД_ДиспетчерРегистрацииКОбмену.ВременнаяТаблицаСуществует(
		Контекст.МенеджерВременныхТаблиц, "ВТ_СсылкиПоУзлам"), "Рабочие таблицы очищены после сбора результата");
	Проверить(КОД_ДиспетчерРегистрацииКОбмену.ВременнаяТаблицаСуществует(
		Контекст.МенеджерВременныхТаблиц, "ВТ_ПредыдущаяВерсия"), "Предыдущая версия сохранена");

КонецПроцедуры

Функция КоличествоСообщений(Узел, ТипСообщения)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Получатель", Узел.Код);
	Запрос.УстановитьПараметр("ТипСообщения", ТипСообщения);
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ РегистрСведений.Демо_КОД_ИсходящаяОчередьСообщений КАК Очередь
		|ГДЕ Очередь.Получатель = &Получатель И Очередь.ТипСообщения = &ТипСообщения";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

Процедура Проверить(Условие, Описание)

	Если НЕ Условие Тогда
		ВызватьИсключение "Проверка не пройдена: " + Описание;
	КонецЕсли;

КонецПроцедуры
